<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CHC.Core</RootNamespace>
    <AssemblyName>CHC.Core</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.8" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.14" />
    <PackageReference Include="System.Management" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- CHC ships in English for now. A language can be added as a file next to CHC.exe. -->
    <EmbeddedResource Include="Localization\Languages\en.json" LogicalName="CHC.Languages.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
