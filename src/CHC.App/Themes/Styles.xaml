<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:CHC.App.Converters"
    xmlns:controls="clr-namespace:CHC.App.Controls"
    xmlns:loc="clr-namespace:CHC.App.Localization"
    xmlns:pres="clr-namespace:CHC.Core.Presentation;assembly=CHC.Core"
    xmlns:vm="clr-namespace:CHC.App.ViewModels"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--  Converters  -->
    <conv:SeverityBrushConverter x:Key="SeverityBrush" />
    <conv:SeverityColorConverter x:Key="SeverityColor" />
    <conv:SeveritySymbolConverter x:Key="SeveritySymbol" />
    <conv:VisibleWhenConverter x:Key="VisibleWhen" />

    <!--  Brand: flat colours only, like the logo  -->
    <Color x:Key="BrandColor">#2B8FE0</Color>
    <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandColor}" />

    <!--  Typography  -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="2,28,0,10" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style x:Key="Overline" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style x:Key="BigValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <!--  Surfaces  -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20,16" />
    </Style>
    <Style x:Key="Tile" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="0,0,10,10" />
    </Style>
    <Style x:Key="IconBadge" TargetType="Border">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <!--  Clickable card (dashboard components)  -->
    <Style x:Key="CardButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Padding="18,14"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource CardStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Sidebar navigation  -->
    <Style x:Key="NavRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border
                        x:Name="Bd"
                        Padding="10,6"
                        Background="Transparent"
                        CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleStrongBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="NavTemplate" DataType="{x:Type vm:NavItem}">
        <StackPanel>
            <TextBlock
                Margin="10,12,0,4"
                FontSize="11"
                FontWeight="Medium"
                Foreground="{DynamicResource TextMutedBrush}"
                Text="{Binding Header}"
                Visibility="{Binding Header, Converter={StaticResource VisibleWhen}}" />
            <RadioButton
                AutomationProperties.Name="{Binding Title}"
                GroupName="nav"
                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                Style="{StaticResource NavRadio}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon
                        x:Name="Icon"
                        FontSize="18"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Symbol="{Binding Icon}" />
                    <TextBlock
                        x:Name="Label"
                        Grid.Column="1"
                        Margin="11,0,8,0"
                        VerticalAlignment="Center"
                        FontSize="13.5"
                        Text="{Binding Title}"
                        TextTrimming="CharacterEllipsis" />
                    <Ellipse
                        Grid.Column="2"
                        Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Fill="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                        Visibility="{Binding Severity, Converter={StaticResource VisibleWhen}}" />
                </Grid>
            </RadioButton>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource BrandBrush}" />
                <Setter TargetName="Label" Property="FontWeight" Value="Medium" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--  Status pill: set DataContext/Tag-free by binding Severity + text in place  -->
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="9,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!--  The link under a finding that opens its steps and reasons  -->
    <Style x:Key="GuideToggle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <StackPanel Background="Transparent" Orientation="Horizontal">
                        <TextBlock
                            x:Name="Label"
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource BrandBrush}"
                            Text="{loc:Tr finding.guide}" />
                        <ui:SymbolIcon
                            x:Name="Chevron"
                            Margin="4,1,0,0"
                            FontSize="12"
                            Foreground="{StaticResource BrandBrush}"
                            Symbol="ChevronDown20" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="Symbol" Value="ChevronUp20" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Finding row  -->
    <DataTemplate x:Key="FindingTemplate" DataType="{x:Type vm:FindingViewModel}">
        <Grid Margin="0,11">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border
                Width="30"
                Height="30"
                VerticalAlignment="Top"
                Background="{Binding Severity, Converter={StaticResource SeverityBrush}, ConverterParameter=36}"
                CornerRadius="8">
                <ui:SymbolIcon
                    FontSize="16"
                    Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                    Symbol="{Binding Symbol}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,12,0">
                <TextBlock
                    Margin="0,5,0,0"
                    FontSize="13.5"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextBrush}"
                    Text="{Binding Title}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,4,0,0"
                    Style="{StaticResource Caption}"
                    Text="{Binding Detail}"
                    Visibility="{Binding Detail, Converter={StaticResource VisibleWhen}}" />
                <Grid Margin="0,6,0,0" Visibility="{Binding Recommendation, Converter={StaticResource VisibleWhen}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon
                        Margin="0,1,6,0"
                        VerticalAlignment="Top"
                        FontSize="14"
                        Foreground="{StaticResource BrandBrush}"
                        Symbol="{Binding AdviceSymbol}" />
                    <TextBlock
                        Grid.Column="1"
                        FontSize="13"
                        Foreground="{DynamicResource TextBrush}"
                        Text="{Binding Recommendation}"
                        TextWrapping="Wrap" />
                </Grid>

                <ui:Button
                    Margin="20,8,0,2"
                    HorizontalAlignment="Left"
                    Command="{Binding OpenCommand}"
                    Content="{Binding ActionText}"
                    Icon="{ui:SymbolIcon ArrowDownload24}"
                    Visibility="{Binding HasAction, Converter={StaticResource VisibleWhen}}" />

                <!--  "How to do it, and why": the steps one by one, and the reason, when the user asks  -->
                <ToggleButton
                    x:Name="GuideToggle"
                    Margin="20,4,0,0"
                    Style="{StaticResource GuideToggle}"
                    Visibility="{Binding HasGuide, Converter={StaticResource VisibleWhen}}" />
                <Border
                    Margin="20,6,0,0"
                    Padding="14,10"
                    Background="{DynamicResource SubtleBrush}"
                    CornerRadius="8"
                    Visibility="{Binding IsChecked, ElementName=GuideToggle, Converter={StaticResource VisibleWhen}}">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,4"
                            Style="{StaticResource Overline}"
                            Text="{loc:Tr finding.steps}"
                            Visibility="{Binding Steps, Converter={StaticResource VisibleWhen}}" />
                        <ItemsControl ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:GuideStep}">
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource BrandBrush}"
                                            Text="{Binding Number}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            FontSize="13"
                                            Foreground="{DynamicResource TextBrush}"
                                            Text="{Binding Text}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{loc:Tr finding.why}" Visibility="{Binding Why, Converter={StaticResource VisibleWhen}}">
                            <TextBlock.Style>
                                <Style BasedOn="{StaticResource Overline}" TargetType="TextBlock">
                                    <Setter Property="Margin" Value="0,10,0,4" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Steps.Count}" Value="0">
                                            <Setter Property="Margin" Value="0,0,0,4" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock
                            FontSize="13"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="{Binding Why}"
                            TextWrapping="Wrap"
                            Visibility="{Binding Why, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Top" Orientation="Horizontal">
                <Border
                    Margin="0,0,6,0"
                    Background="{DynamicResource SubtleBrush}"
                    Style="{StaticResource Pill}"
                    ToolTip="{Binding NonChcTip}"
                    Visibility="{Binding IsNonChc, Converter={StaticResource VisibleWhen}}">
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding NonChcText}" />
                </Border>
                <Border
                    Margin="0,0,6,0"
                    Background="{DynamicResource SubtleBrush}"
                    Style="{StaticResource Pill}"
                    Visibility="{Binding ShowComponent, Converter={StaticResource VisibleWhen}}">
                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Component}" />
                </Border>
                <Border Background="{Binding Severity, Converter={StaticResource SeverityBrush}, ConverterParameter=40}" Style="{StaticResource Pill}">
                    <TextBlock
                        FontSize="11.5"
                        FontWeight="SemiBold"
                        Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                        Text="{Binding SeverityText}" />
                </Border>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!--  A program with a newer version: one line, it is only a suggestion  -->
    <DataTemplate x:Key="ProgramUpdateTemplate" DataType="{x:Type vm:ProgramUpdateRow}">
        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                FontSize="13"
                Foreground="{DynamicResource TextBrush}"
                Text="{Binding Name}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                Grid.Column="1"
                Margin="16,0,0,0"
                Style="{StaticResource Caption}"
                Text="{Binding Versions}" />
        </Grid>
    </DataTemplate>

    <!--  Something CHC can't look up itself: the maker's page  -->
    <DataTemplate x:Key="ManualCheckTemplate" DataType="{x:Type vm:ManualCheck}">
        <Grid Margin="0,11">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border
                Width="30"
                Height="30"
                VerticalAlignment="Top"
                Background="{DynamicResource SubtleBrush}"
                CornerRadius="8">
                <ui:SymbolIcon
                    FontSize="16"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Symbol="Globe24" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,12,0">
                <TextBlock
                    Margin="0,5,0,0"
                    FontSize="13.5"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextBrush}"
                    Text="{Binding Title}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,4,0,0"
                    Style="{StaticResource Caption}"
                    Text="{Binding Detail}" />
            </StackPanel>
            <ui:Button
                Grid.Column="2"
                VerticalAlignment="Top"
                Command="{Binding Open}"
                Content="{Binding ButtonText}"
                Icon="{ui:SymbolIcon Open24}" />
        </Grid>
    </DataTemplate>

    <!--  Headline tile  -->
    <DataTemplate x:Key="HighlightTemplate" DataType="{x:Type vm:HighlightViewModel}">
        <Border Style="{StaticResource Tile}">
            <StackPanel>
                <TextBlock Style="{StaticResource Caption}" Text="{Binding Label}" TextWrapping="NoWrap" />
                <TextBlock Margin="0,2,0,0" Style="{StaticResource BigValue}" Text="{Binding Value}" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!--  Usage meter  -->
    <DataTemplate x:Key="MeterTemplate" DataType="{x:Type vm:MeterViewModel}">
        <StackPanel Margin="0,6,0,8">
            <Grid>
                <TextBlock FontSize="13.5" Foreground="{DynamicResource TextBrush}" Text="{Binding Label}" />
                <TextBlock
                    HorizontalAlignment="Right"
                    Style="{StaticResource Caption}"
                    Text="{Binding Caption}" />
            </Grid>
            <controls:MeterBar
                Margin="0,6,0,0"
                BarBrush="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                Value="{Binding Percent}" />
        </StackPanel>
    </DataTemplate>

    <!--  Sensor table  -->
    <DataTemplate x:Key="SensorHeaderTemplate">
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="180" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Overline}" Text="{loc:Tr col.sensor}" />
            <TextBlock Grid.Column="1" Style="{StaticResource Overline}" Text="{loc:Tr col.type}" />
            <TextBlock Grid.Column="2" Style="{StaticResource Overline}" Text="{loc:Tr col.value}" />
            <TextBlock Grid.Column="3" Style="{StaticResource Overline}" Text="{loc:Tr col.min}" />
            <TextBlock Grid.Column="4" Style="{StaticResource Overline}" Text="{loc:Tr col.max}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="SensorRowTemplate" DataType="{x:Type vm:SensorRowViewModel}">
        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="180" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>
            <TextBlock
                FontSize="13"
                Foreground="{DynamicResource TextBrush}"
                Text="{Binding Name}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                Grid.Column="1"
                FontSize="13"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Text="{Binding TypeName}" />
            <TextBlock
                Grid.Column="2"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextBrush}"
                Text="{Binding Value}" />
            <TextBlock
                Grid.Column="3"
                FontSize="13"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Text="{Binding Min}" />
            <TextBlock
                Grid.Column="4"
                FontSize="13"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Text="{Binding Max}" />
        </Grid>
    </DataTemplate>

    <!--  Must come before DeviceTemplate: StaticResource lookups cannot see keys defined later in the same dictionary  -->
    <Style x:Key="ReadOnlyGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="AutoGenerateColumns" Value="True" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="controls:ScrollBubble.IsEnabled" Value="True" />
    </Style>

    <!--  A device card: live tiles, meters, specifications, tables and raw sensors (component and performance pages)  -->
    <DataTemplate x:Key="DeviceTemplate" DataType="{x:Type vm:DeviceViewModel}">
        <Border Margin="0,0,0,16" Style="{StaticResource Card}">
            <StackPanel>
                <Grid>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextBrush}"
                            Text="{Binding Title}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,3,0,0"
                            Style="{StaticResource Caption}"
                            Text="{Binding Subtitle}"
                            Visibility="{Binding Subtitle, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                    <Border
                        VerticalAlignment="Top"
                        Background="{Binding Severity, Converter={StaticResource SeverityBrush}, ConverterParameter=40}"
                        Style="{StaticResource Pill}"
                        Visibility="{Binding SeverityText, Converter={StaticResource VisibleWhen}}">
                        <TextBlock
                            FontSize="11.5"
                            FontWeight="SemiBold"
                            Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                            Text="{Binding SeverityText}" />
                    </Border>
                </Grid>

                <ItemsControl
                    Margin="0,16,-10,0"
                    ItemTemplate="{StaticResource HighlightTemplate}"
                    ItemsSource="{Binding Highlights}"
                    Visibility="{Binding Highlights, Converter={StaticResource VisibleWhen}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:ResponsiveGrid MaxColumns="4" MinItemWidth="170" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <ItemsControl
                    Margin="0,4,0,0"
                    ItemTemplate="{StaticResource MeterTemplate}"
                    ItemsSource="{Binding Meters}"
                    Visibility="{Binding Meters, Converter={StaticResource VisibleWhen}}" />

                <!--  Technical specifications  -->
                <Expander
                    Margin="0,14,0,0"
                    IsExpanded="True"
                    Visibility="{Binding Specs, Converter={StaticResource VisibleWhen}}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon FontSize="16" Symbol="DocumentText24" />
                            <TextBlock
                                Margin="10,0,0,0"
                                FontWeight="SemiBold"
                                Text="{loc:Tr component.specs}" />
                        </StackPanel>
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding Specs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:ResponsiveGrid MaxColumns="2" MinItemWidth="380" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type pres:SpecGroup}">
                                <StackPanel Margin="0,4,24,12">
                                    <TextBlock Style="{StaticResource Overline}" Text="{Binding Title}" />
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type pres:SpecRow}">
                                                <Border
                                                    Padding="0,6"
                                                    BorderBrush="{DynamicResource DividerBrush}"
                                                    BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="0.42*" />
                                                            <ColumnDefinition Width="0.58*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            Margin="0,0,10,0"
                                                            FontSize="13"
                                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                                            Text="{Binding Key}"
                                                            TextWrapping="Wrap" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            FontSize="13"
                                                            Foreground="{DynamicResource TextBrush}"
                                                            Text="{Binding Value}"
                                                            TextWrapping="Wrap" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <!--  Tables (memory modules, SMART attributes, events...)  -->
                <ItemsControl ItemsSource="{Binding Tables}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TableViewModel}">
                            <Expander Margin="0,10,0,0" IsExpanded="{Binding IsExpanded, Mode=OneTime}">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon FontSize="16" Symbol="Table24" />
                                        <TextBlock
                                            Margin="10,0,0,0"
                                            FontWeight="SemiBold"
                                            Text="{Binding Title}" />
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            Foreground="{DynamicResource TextMutedBrush}"
                                            Text="{Binding RowCount, StringFormat=({0})}" />
                                    </StackPanel>
                                </Expander.Header>
                                <DataGrid ItemsSource="{Binding View}" Style="{StaticResource ReadOnlyGrid}" />
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  Raw live sensors: the most technical level  -->
                <Expander Margin="0,10,0,0" Visibility="{Binding Sensors, Converter={StaticResource VisibleWhen}}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon FontSize="16" Symbol="Pulse24" />
                            <TextBlock
                                Margin="10,0,0,0"
                                FontWeight="SemiBold"
                                Text="{Binding SensorsHeader}" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <ContentControl ContentTemplate="{StaticResource SensorHeaderTemplate}" />
                        <ItemsControl ItemTemplate="{StaticResource SensorRowTemplate}" ItemsSource="{Binding Sensors}" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!--  Segmented choice (day / week / month / year, timeline filters): a ListBox with these items  -->
    <Style x:Key="SegmentItem" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border
                        x:Name="Bd"
                        Margin="2"
                        Padding="13,5"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        CornerRadius="6">
                        <TextBlock
                            x:Name="Label"
                            FontSize="13"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="{Binding Title}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter TargetName="Label" Property="FontWeight" Value="Medium" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Segments" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SegmentItem}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
