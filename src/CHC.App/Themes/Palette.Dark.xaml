<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  CHC's dark palette. The views use only these tokens, so another UI toolkit (Linux, macOS) can take the
          same names; the second part re-points WPF-UI's own keys at the same colours, so its controls match.
          Generated once from WPF-UI 4.3's theme keys; edit the values here.  -->

    <!--  The window and page background  -->
    <Color x:Key="PageColor">#FF141619</Color>
    <SolidColorBrush x:Key="PageBrush" Color="#FF141619" />
    <!--  The navigation column  -->
    <Color x:Key="SidebarColor">#FF181A1E</Color>
    <SolidColorBrush x:Key="SidebarBrush" Color="#FF181A1E" />
    <!--  Cards  -->
    <Color x:Key="CardColor">#FF1D2024</Color>
    <SolidColorBrush x:Key="CardBrush" Color="#FF1D2024" />
    <!--  A clickable card under the mouse  -->
    <Color x:Key="CardHoverColor">#FF23262B</Color>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#FF23262B" />
    <!--  The hairline around cards  -->
    <Color x:Key="CardStrokeColor">#14FFFFFF</Color>
    <SolidColorBrush x:Key="CardStrokeBrush" Color="#14FFFFFF" />
    <!--  Tiles, insets and hover backgrounds  -->
    <Color x:Key="SubtleColor">#0AFFFFFF</Color>
    <SolidColorBrush x:Key="SubtleBrush" Color="#0AFFFFFF" />
    <!--  The selected page in the sidebar, pressed items  -->
    <Color x:Key="SubtleStrongColor">#14FFFFFF</Color>
    <SolidColorBrush x:Key="SubtleStrongBrush" Color="#14FFFFFF" />
    <!--  Lines between rows  -->
    <Color x:Key="DividerColor">#12FFFFFF</Color>
    <SolidColorBrush x:Key="DividerBrush" Color="#12FFFFFF" />
    <!--  Hovered borders  -->
    <Color x:Key="BorderStrongColor">#2EFFFFFF</Color>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#2EFFFFFF" />
    <!--  Body text  -->
    <Color x:Key="TextColor">#FFECEEF1</Color>
    <SolidColorBrush x:Key="TextBrush" Color="#FFECEEF1" />
    <!--  Supporting text  -->
    <Color x:Key="TextSecondaryColor">#FFA6ACB6</Color>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFA6ACB6" />
    <!--  Captions, column headers  -->
    <Color x:Key="TextMutedColor">#FF7C838E</Color>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF7C838E" />
    <!--  Warning text and icons  -->
