<UserControl
    x:Class="CHC.App.Views.PerformanceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:CHC.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:CHC.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:CHC.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:PerformanceViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="LiveTile" BasedOn="{StaticResource Tile}" TargetType="Border" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,20,32,36">

            <!--  Header  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="56"
                    Height="56"
                    Background="{DynamicResource SubtleBrush}"
                    CornerRadius="14">
                    <ui:SymbolIcon
                        FontSize="28"
                        Foreground="{StaticResource BrandBrush}"
                        Symbol="TopSpeed24" />
                </Border>
                <StackPanel
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{loc:Tr nav.performance}" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="{loc:Tr perf.page.subtitle}" />
                </StackPanel>
            </Grid>

            <!--  Start / stop  -->
            <Border Margin="0,22,0,0" Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Status}" TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,6,0,0"
                                Style="{StaticResource Caption}"
                                Text="{loc:Tr perf.howto}" />
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <ui:Button
                                Appearance="Primary"
                                Command="{Binding StartCommand}"
                                Content="{loc:Tr perf.start}"
                                Icon="{ui:SymbolIcon Play24}"
                                Visibility="{Binding IsRunning, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" />
                            <ui:Button
                                Appearance="Caution"
                                Command="{Binding StopCommand}"
                                Content="{loc:Tr perf.stop}"
                                Icon="{ui:SymbolIcon Stop24}"
                                Visibility="{Binding IsRunning, Converter={StaticResource VisibleWhen}}" />
                        </Grid>
                    </Grid>

                    <Border
                        Margin="0,14,0,0"
                        Padding="14,10"
                        Background="{DynamicResource WarningSubtleBrush}"
                        CornerRadius="8"
                        Visibility="{Binding ShowAdminHint, Converter={StaticResource VisibleWhen}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon
                                VerticalAlignment="Center"
                                FontSize="18"
                                Foreground="{DynamicResource WarningBrush}"
                                Symbol="ShieldError24" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="10,0,12,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource Body}"
                                Text="{loc:Tr perf.needadmin}" />
                            <ui:Button
                                Grid.Column="2"
                                Command="{Binding Main.RestartAsAdminCommand}"
                                Content="{loc:Tr admin.restart}"
                                Icon="{ui:SymbolIcon ShieldCheckmark24}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!--  Live values  -->
            <StackPanel Visibility="{Binding HasLive, Converter={StaticResource VisibleWhen}}">
                <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr perf.live}" />
                <controls:ResponsiveGrid
                    Margin="0,0,-10,0"
                    MaxColumns="4"
                    MinItemWidth="170">
                    <Border Style="{StaticResource LiveTile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr label.fps}" />
                            <TextBlock FontSize="30" Style="{StaticResource BigValue}" Text="{Binding FpsText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource LiveTile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr label.onepercentlow}" />
                            <TextBlock FontSize="30" Style="{StaticResource BigValue}" Text="{Binding OnePercentText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource LiveTile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr label.frametime}" />
                            <TextBlock FontSize="30" Style="{StaticResource BigValue}" Text="{Binding FrameTimeText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource LiveTile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr label.stutters}" />
                            <TextBlock FontSize="30" Style="{StaticResource BigValue}" Text="{Binding StuttersText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource LiveTile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr label.cpucore}" />
                            <TextBlock Style="{StaticResource BigValue}" Text="{Binding CpuCoreText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource LiveTile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr label.gpuload}" />
                            <TextBlock Style="{StaticResource BigValue}" Text="{Binding GpuLoadText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource LiveTile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr label.gputemp}" />
                            <TextBlock Style="{StaticResource BigValue}" Text="{Binding GpuTempText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource LiveTile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr label.vramused}" />
                            <TextBlock Style="{StaticResource BigValue}" Text="{Binding VramText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource LiveTile}" Visibility="{Binding HasPower, Converter={StaticResource VisibleWhen}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr perf.live.power}" />
                            <TextBlock Style="{StaticResource BigValue}" Text="{Binding PowerText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource LiveTile}" Visibility="{Binding HasBattery, Converter={StaticResource VisibleWhen}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr component.battery}" />
                            <TextBlock Style="{StaticResource BigValue}" Text="{Binding BatteryText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource LiveTile}" Visibility="{Binding IsOnline, Converter={StaticResource VisibleWhen}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr label.ping}" />
                            <TextBlock Style="{StaticResource BigValue}" Text="{Binding PingText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource LiveTile}" Visibility="{Binding IsOnline, Converter={StaticResource VisibleWhen}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr label.packetloss}" />
                            <TextBlock Style="{StaticResource BigValue}" Text="{Binding LossText}" />
                        </StackPanel>
                    </Border>
                </controls:ResponsiveGrid>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Overline}" Text="{loc:Tr perf.chart.fps}" />
                            <controls:Sparkline
                                Height="110"
                                Capacity="120"
                                Maximum="{Binding FpsChartMax}"
                                StrokeColor="{StaticResource BrandColor}"
                                Values="{Binding FpsHistory}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Overline}" Text="{loc:Tr perf.chart.frametime}" />
                            <controls:Sparkline
                                Height="110"
                                Capacity="120"
                                Maximum="{Binding FrameChartMax}"
                                StrokeColor="#E8A317"
                                Values="{Binding FrameTimeHistory}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!--  The games in the history  -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr perf.games.title}" />
            <TextBlock
                Margin="2,-4,0,10"
                Style="{StaticResource Caption}"
                Text="{loc:Tr perf.games.detail}" />
            <Border
                Margin="0,0,0,12"
                Padding="14,10"
                Background="{DynamicResource SubtleBrush}"
                CornerRadius="8"
                Visibility="{Binding GamesHint, Converter={StaticResource VisibleWhen}}">
                <TextBlock Style="{StaticResource Caption}" Text="{Binding GamesHint}" />
            </Border>
            <Border Style="{StaticResource Card}" Visibility="{Binding NoGames, Converter={StaticResource VisibleWhen}}">
                <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr perf.games.empty}" />
            </Border>
            <ItemsControl ItemsSource="{Binding Games}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:GameCard}">
                        <Border Margin="0,0,0,12" Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Title}" />
                                    <Border
                                        Background="{DynamicResource SubtleBrush}"
                                        Style="{StaticResource Pill}"
                                        ToolTip="{loc:Tr source.nonchc.tip}"
                                        Visibility="{Binding IsNonChc, Converter={StaticResource VisibleWhen}}">
                                        <TextBlock
                                            FontSize="11.5"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            Text="{loc:Tr source.nonchc}" />
                                    </Border>
                                </Grid>
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Style="{StaticResource Caption}"
                                    Text="{Binding Subtitle}" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Style="{StaticResource Caption}"
                                    Text="{Binding SourceNote}"
                                    Visibility="{Binding SourceNote, Converter={StaticResource VisibleWhen}}" />
                                <ItemsControl Margin="0,14,-10,0" ItemsSource="{Binding Tiles}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <controls:ResponsiveGrid MaxColumns="4" MinItemWidth="170" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:HistoryTile}">
                                            <Border Style="{StaticResource Tile}">
                                                <StackPanel>
                                                    <TextBlock
                                                        Style="{StaticResource Caption}"
                                                        Text="{Binding Title}"
                                                        TextWrapping="NoWrap" />
                                                    <TextBlock
                                                        Margin="0,2,0,0"
                                                        Style="{StaticResource BigValue}"
                                                        Text="{Binding Value}" />
                                                    <TextBlock
                                                        Style="{StaticResource Caption}"
                                                        Text="{Binding Detail}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap"
                                                        ToolTip="{Binding Detail}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Margin="0,4,0,6" Visibility="{Binding HasChart, Converter={StaticResource VisibleWhen}}">
                                    <TextBlock Style="{StaticResource Overline}" Text="{loc:Tr perf.games.chart}" />
                                    <controls:TimeChart
                                        Height="120"
                                        Margin="-8,0,0,0"
                                        Connect="True"
                                        Floor="0"
                                        Format="{Binding FpsFormat}"
                                        From="{Binding From}"
                                        MinSpan="30"
                                        Series="{Binding Series}"
                                        Slot="{Binding Slot}"
                                        To="{Binding To}" />
                                </StackPanel>
                                <StackPanel Margin="0,4,0,6" Visibility="{Binding HasPlayedChart, Converter={StaticResource VisibleWhen}}">
                                    <TextBlock Style="{StaticResource Overline}" Text="{Binding PlayedTitle}" />
                                    <controls:TimeChart
                                        Height="130"
                                        Margin="-8,0,0,0"
                                        Connect="True"
                                        Floor="0"
                                        Format="{Binding MinutesFormat}"
                                        From="{Binding PlayedFrom}"
                                        MinSpan="30"
                                        Series="{Binding PlayedSeries}"
                                        ShowLegend="True"
                                        Slot="{Binding Slot}"
                                        To="{Binding To}" />
                                </StackPanel>
                                <ItemsControl ItemTemplate="{StaticResource FindingTemplate}" ItemsSource="{Binding Findings}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  Analysis  -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr perf.results}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,6"
                        Style="{StaticResource Caption}"
                        Text="{Binding Result.Summary}" />
                    <ItemsControl ItemTemplate="{StaticResource FindingTemplate}" ItemsSource="{Binding Result.Findings}" />
                </StackPanel>
            </Border>
            <ItemsControl
                Margin="0,16,0,0"
                ItemTemplate="{StaticResource DeviceTemplate}"
                ItemsSource="{Binding Result.Devices}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
