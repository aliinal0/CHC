<UserControl
    x:Class="CHC.App.Views.ReportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:CHC.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:CHC.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:ReportViewModel}"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="980" Margin="32,26,32,36" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="{loc:Tr report.page.title}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="{loc:Tr report.page.subtitle}" />

            <Border Margin="0,22,0,0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr report.options}" />
                    <CheckBox
                        Margin="0,14,0,0"
                        Content="{loc:Tr report.option.sensors}"
                        IsChecked="{Binding IncludeSensors}" />
                    <CheckBox
                        Margin="0,8,0,0"
                        Content="{loc:Tr report.option.serials}"
                        IsChecked="{Binding IncludeSerials}" />
                    <TextBlock
                        Margin="30,2,0,0"
                        Style="{StaticResource Caption}"
                        Text="{loc:Tr report.option.serials.hint}" />

                    <WrapPanel Margin="0,20,0,0">
                        <ui:Button
                            Margin="0,0,8,8"
                            Appearance="Primary"
                            Command="{Binding SavePdfCommand}"
                            Content="{loc:Tr report.save.pdf}"
                            Icon="{ui:SymbolIcon DocumentPdf24}" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Command="{Binding SaveHtmlCommand}"
                            Content="{loc:Tr report.save.html}"
                            Icon="{ui:SymbolIcon Globe24}" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Command="{Binding SaveJsonCommand}"
                            Content="{loc:Tr report.save.json}"
                            Icon="{ui:SymbolIcon Code24}" />
                        <ui:Button
                            Margin="0,0,8,8"
                            Command="{Binding CopySummaryCommand}"
                            Content="{loc:Tr report.copy}"
                            Icon="{ui:SymbolIcon Copy24}" />
                    </WrapPanel>

                    <ProgressBar
                        Margin="0,6,0,0"
                        IsIndeterminate="True"
                        Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}" />
                    <Border
                        Margin="0,10,0,0"
                        Padding="14,10"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="8"
                        Visibility="{Binding StatusMessage, Converter={StaticResource VisibleWhen}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding StatusMessage}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding LastPath}" />
                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Visibility="{Binding HasLastPath, Converter={StaticResource VisibleWhen}}">
                                <ui:Button
                                    Margin="0,0,8,0"
                                    Command="{Binding OpenLastCommand}"
                                    Content="{loc:Tr action.open}"
                                    Icon="{ui:SymbolIcon Open24}" />
                                <ui:Button
                                    Command="{Binding ShowInFolderCommand}"
                                    Content="{loc:Tr action.showinfolder}"
                                    Icon="{ui:SymbolIcon FolderOpen24}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr report.contents}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon
                            FontSize="20"
                            Foreground="{StaticResource BrandBrush}"
                            Symbol="HeartPulse24" />
                        <StackPanel Grid.Column="1" Margin="14,0,0,10">
                            <TextBlock FontWeight="SemiBold" Style="{StaticResource Body}" Text="{loc:Tr report.contents.1}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr report.contents.1.detail}" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon
                            FontSize="20"
                            Foreground="{StaticResource BrandBrush}"
                            Symbol="Lightbulb20" />
                        <StackPanel Grid.Column="1" Margin="14,0,0,10">
                            <TextBlock FontWeight="SemiBold" Style="{StaticResource Body}" Text="{loc:Tr report.contents.2}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr report.contents.2.detail}" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon
                            FontSize="20"
                            Foreground="{StaticResource BrandBrush}"
                            Symbol="DocumentText24" />
                        <StackPanel Grid.Column="1" Margin="14,0,0,10">
                            <TextBlock FontWeight="SemiBold" Style="{StaticResource Body}" Text="{loc:Tr report.contents.3}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr report.contents.3.detail}" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon
                            FontSize="20"
                            Foreground="{StaticResource BrandBrush}"
                            Symbol="LockClosed24" />
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock FontWeight="SemiBold" Style="{StaticResource Body}" Text="{loc:Tr report.contents.4}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr report.contents.4.detail}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
