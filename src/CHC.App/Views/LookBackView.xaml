<UserControl
    x:Class="CHC.App.Views.LookBackView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:CHC.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:CHC.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:CHC.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:LookBackViewModel}"
    mc:Ignorable="d">

    <ScrollViewer FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,20,32,36">

            <!--  Header  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="56"
                    Height="56"
                    Background="{DynamicResource SubtleBrush}"
                    CornerRadius="14">
                    <ui:SymbolIcon
                        FontSize="28"
                        Foreground="{StaticResource BrandBrush}"
                        Symbol="History24" />
                </Border>
                <StackPanel
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{loc:Tr nav.lookback}" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="{loc:Tr lookback.subtitle}" />
                </StackPanel>
            </Grid>

            <!--  Windows' records  -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr lookback.records}" />
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource Body}" Text="{loc:Tr lookback.records.detail}" />
                        <TextBlock
                            Margin="0,6,0,0"
                            Style="{StaticResource Caption}"
                            Text="{loc:Tr lookback.records.how}" />
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="13"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="{Binding Status}"
                            TextWrapping="Wrap" />
                        <CheckBox
                            Margin="-10,8,0,0"
                            Content="{loc:Tr lookback.auto}"
                            IsChecked="{Binding AutoRead}"
                            Visibility="{Binding ShowRead, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                    <ui:Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Appearance="Primary"
                        Command="{Binding ReadCommand}"
                        Content="{loc:Tr lookback.read}"
                        ToolTip="{loc:Tr lookback.read.tip}"
                        IsEnabled="{Binding CanRead}"
                        Visibility="{Binding ShowRead, Converter={StaticResource VisibleWhen}}" />
                </Grid>
            </Border>

            <!--  Numbers  -->
            <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:LookBackTile}">
                        <Border Margin="0,0,10,0" Style="{StaticResource Tile}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Overline}" Text="{Binding Label}" />
                                <TextBlock
                                    Style="{StaticResource BigValue}"
                                    Text="{Binding Value}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding Detail}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  The map  -->
            <Grid>
                <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr lookback.map}" />
                <Border
                    Margin="0,0,0,8"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource SubtleBrush}"
                    Style="{StaticResource Pill}"
                    ToolTip="{loc:Tr source.nonchc.tip}">
                    <TextBlock
                        FontSize="11.5"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{loc:Tr source.nonchc}" />
                </Border>
            </Grid>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <controls:ActivityGrid
                        x:Name="Grid"
                        Map="{Binding Map}"
                        SelectedDay="{Binding SelectedDay}"
                        SelectedHour="{Binding SelectedHour}" />
                    <StackPanel Margin="34,12,0,0" Orientation="Horizontal">
                        <Border
                            Width="12"
                            Height="12"
                            Background="{StaticResource BrandBrush}"
                            CornerRadius="2" />
                        <TextBlock
                            Margin="6,0,18,0"
                            Style="{StaticResource Caption}"
                            Text="{loc:Tr lookback.legend.on}" />
                        <Border
                            Width="12"
                            Height="12"
                            Background="#2EB86A"
                            CornerRadius="2" />
                        <TextBlock
                            Margin="6,0,18,0"
                            Style="{StaticResource Caption}"
                            Text="{loc:Tr lookback.legend.game}" />
                        <Border
                            Width="12"
                            Height="12"
                            Background="{DynamicResource SubtleStrongBrush}"
                            CornerRadius="2" />
                        <TextBlock
                            Margin="6,0,18,0"
                            Style="{StaticResource Caption}"
                            Text="{loc:Tr lookback.legend.asleep}" />
                        <Border
                            Width="12"
                            Height="12"
                            Background="{DynamicResource SubtleBrush}"
                            CornerRadius="2" />
                        <TextBlock
                            Margin="6,0,18,0"
                            Style="{StaticResource Caption}"
                            Text="{loc:Tr lookback.legend.off}" />
                        <Border
                            Width="12"
                            Height="12"
                            Background="{StaticResource BrandBrush}"
                            CornerRadius="2">
                            <Ellipse
                                Width="4"
                                Height="4"
                                Fill="White" />
                        </Border>
                        <TextBlock
                            Margin="6,0,0,0"
                            Style="{StaticResource Caption}"
                            Text="{loc:Tr lookback.legend.recorded}" />
                    </StackPanel>
                    <TextBlock
                        Margin="34,8,0,0"
                        Style="{StaticResource Caption}"
                        Text="{loc:Tr lookback.map.note}" />
                </StackPanel>
            </Border>

            <!--  Hours on, per day  -->
            <StackPanel Visibility="{Binding HasOnChart, Converter={StaticResource VisibleWhen}}">
                <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr lookback.perday}" />
                <Border Style="{StaticResource Card}">
                    <controls:TimeChart
                        Height="170"
                        Margin="-8,0,0,0"
                        Connect="True"
                        Floor="0"
                        Format="{Binding HoursFormat}"
                        From="{Binding ChartFrom}"
                        MinSpan="4"
                        Series="{Binding OnSeries}"
                        ShowLegend="True"
                        Slot="{Binding ChartSlot}"
                        To="{Binding ChartTo}" />
                </Border>
            </StackPanel>

            <!--  What ran  -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr lookback.hour}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock
                        Style="{StaticResource Caption}"
                        Text="{loc:Tr lookback.hour.hint}"
                        Visibility="{Binding SelectionTitle, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" />
                    <TextBlock
                        FontSize="13.5"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextBrush}"
                        Text="{Binding SelectionTitle}" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{StaticResource Caption}"
                        Text="{loc:Tr lookback.hour.none}"
                        Visibility="{Binding NoRows, Converter={StaticResource VisibleWhen}}" />
                    <Grid Margin="0,10,0,4" Visibility="{Binding Rows, Converter={StaticResource VisibleWhen}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Overline}" Text="{loc:Tr lookback.col.program}" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource Overline}"
                            Text="{loc:Tr lookback.col.front}" />
                        <TextBlock
                            Grid.Column="2"
                            Style="{StaticResource Overline}"
                            Text="{loc:Tr lookback.col.running}" />
                        <TextBlock
                            Grid.Column="3"
                            Style="{StaticResource Overline}"
                            Text="{loc:Tr lookback.col.cpu}" />
                        <TextBlock
                            Grid.Column="4"
                            Style="{StaticResource Overline}"
                            Text="{loc:Tr lookback.col.disk}" />
                        <TextBlock
                            Grid.Column="5"
                            Style="{StaticResource Overline}"
                            Text="{loc:Tr lookback.col.source}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LookBackRow}">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontSize="13.5"
                                        FontWeight="Medium"
                                        Foreground="{DynamicResource TextBrush}"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="13"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        Text="{Binding Front}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        FontSize="13"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        Text="{Binding Running}" />
                                    <TextBlock
                                        Grid.Column="3"
                                        FontSize="13"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        Text="{Binding Processor}" />
                                    <TextBlock
                                        Grid.Column="4"
                                        FontSize="13"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        Text="{Binding Disk}" />
                                    <TextBlock
                                        Grid.Column="5"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        Text="{Binding Source}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
