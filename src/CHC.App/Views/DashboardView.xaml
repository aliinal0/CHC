<UserControl
    x:Class="CHC.App.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:CHC.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:CHC.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:CHC.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,20,32,36">

            <!--  Header  -->
            <Grid>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="{loc:Tr dashboard.title}" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding LastScanText}" />
                </StackPanel>
                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,8,0"
                        Command="{Binding Main.ScanCommand}"
                        Content="{loc:Tr action.rescan}"
                        Icon="{ui:SymbolIcon ArrowClockwise24}" />
                    <ui:Button
                        Appearance="Primary"
                        Command="{Binding Main.Report.SavePdfCommand}"
                        Content="{loc:Tr action.export}"
                        Icon="{ui:SymbolIcon DocumentPdf24}" />
                </StackPanel>
            </Grid>

            <!--  Hero  -->
            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel HorizontalAlignment="Center">
                        <Grid
                            Width="184"
                            Height="184"
                            Margin="0,4,0,0">
                            <controls:ScoreRing
                                RingBrush="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                                Thickness="14"
                                Value="{Binding Score}" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="52"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextBrush}"
                                    Text="{Binding Score}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                                    Text="{Binding RatingText}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock
                            MaxWidth="300"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            FontSize="14"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Text="{Binding Headline}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <UniformGrid
                            Margin="0,16,0,0"
                            Columns="4">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Foreground="{Binding Source={x:Static vm:SeverityValues.Critical}, Converter={StaticResource SeverityBrush}}"
                                    Text="{Binding CriticalCount}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource Caption}"
                                    Text="{loc:Tr dashboard.critical}" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Foreground="{Binding Source={x:Static vm:SeverityValues.Warning}, Converter={StaticResource SeverityBrush}}"
                                    Text="{Binding WarningCount}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource Caption}"
                                    Text="{loc:Tr dashboard.warnings}" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Foreground="{Binding Source={x:Static vm:SeverityValues.Info}, Converter={StaticResource SeverityBrush}}"
                                    Text="{Binding InfoCount}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource Caption}"
                                    Text="{loc:Tr dashboard.notes}" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Foreground="{Binding Source={x:Static vm:SeverityValues.Update}, Converter={StaticResource SeverityBrush}}"
                                    Text="{Binding UpdateCount}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource Caption}"
                                    Text="{loc:Tr dashboard.updates}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr dashboard.system}" />
                        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding SystemRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SummaryRow}">
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="36"
                                            Height="36"
                                            Background="{DynamicResource SubtleBrush}"
                                            CornerRadius="8">
                                            <ui:SymbolIcon
                                                FontSize="18"
                                                Foreground="{StaticResource BrandBrush}"
                                                Symbol="{Binding Icon}" />
                                        </Border>
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="11.5"
                                                Foreground="{DynamicResource TextMutedBrush}"
                                                Text="{Binding Label}" />
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextBrush}"
                                                Text="{Binding Value}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding Value}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!--  Lately: the last week, the newest changes, what heated the PC  -->
            <Grid Margin="0,16,0,0" Visibility="{Binding HasLately, Converter={StaticResource VisibleWhen}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="4*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <ui:HyperlinkButton
                                Padding="6,2"
                                Command="{Binding Main.NavigateCommand}"
                                CommandParameter="history"
                                Content="{loc:Tr dashboard.lately.more}"
                                DockPanel.Dock="Right" />
                            <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr dashboard.lately.week}" />
                        </DockPanel>
                        <TextBlock
                            Margin="0,8,0,0"
                            Style="{StaticResource Caption}"
                            Text="{loc:Tr dashboard.lately.wait}"
                            Visibility="{Binding HasWeek, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" />
                        <StackPanel Visibility="{Binding HasWeek, Converter={StaticResource VisibleWhen}}">
                            <controls:TimeChart
                                Height="130"
                                Margin="-8,8,0,0"
                                Format="{Binding Celsius}"
                                From="{Binding WeekFrom}"
                                MinSpan="15"
                                Series="{Binding WeekTemperatures}"
                                Slot="{Binding WeekSlot}"
                                To="{Binding WeekTo}" />
                            <TextBlock
                                Margin="0,6,0,0"
                                Style="{StaticResource Caption}"
                                Text="{Binding WeekPeak}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <ui:HyperlinkButton
                                Padding="6,2"
                                Command="{Binding Main.NavigateCommand}"
                                CommandParameter="timeline"
                                Content="{loc:Tr dashboard.lately.more}"
                                DockPanel.Dock="Right" />
                            <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr dashboard.lately.changes}" />
                        </DockPanel>
                        <TextBlock
                            Margin="0,8,0,0"
                            Style="{StaticResource Caption}"
                            Text="{loc:Tr dashboard.lately.nochanges}"
                            Visibility="{Binding RecentChanges, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" />
                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding RecentChanges}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TimelineItem}">
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon
                                            Margin="0,2,10,0"
                                            VerticalAlignment="Top"
                                            FontSize="16"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            Symbol="{Binding Icon}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock
                                                Style="{StaticResource Body}"
                                                Text="{Binding Title}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap"
                                                ToolTip="{Binding Title}" />
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Time}" />
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Foreground="{Binding Source={x:Static vm:SeverityValues.Warning}, Converter={StaticResource SeverityBrush}}"
                                                Style="{StaticResource Caption}"
                                                Text="{Binding Note}"
                                                Visibility="{Binding HasNote, Converter={StaticResource VisibleWhen}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr dashboard.lately.heat}" />
                        <TextBlock
                            Margin="0,8,0,0"
                            Style="{StaticResource Caption}"
                            Text="{loc:Tr dashboard.lately.heat.wait}"
                            Visibility="{Binding HasHeat, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" />
                        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding HeatApps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:HistoryApp}">
                                    <StackPanel Margin="0,5">
                                        <DockPanel>
                                            <TextBlock
                                                DockPanel.Dock="Right"
                                                Style="{StaticResource Caption}"
                                                Text="{Binding Time}" />
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Style="{StaticResource Body}"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                        </DockPanel>
                                        <controls:MeterBar
                                            Height="5"
                                            Margin="0,5,0,3"
                                            BarBrush="{StaticResource BrandBrush}"
                                            Value="{Binding Share}" />
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Temperatures}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!--  Components  -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr dashboard.components}" />
            <ItemsControl Margin="0,0,-12,0" ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:ResponsiveGrid MaxColumns="4" MinItemWidth="290" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ComponentCardViewModel}">
                        <Button
                            Margin="0,0,12,12"
                            Command="{Binding OpenCommand}"
                            Style="{StaticResource CardButton}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{Binding Severity, Converter={StaticResource SeverityBrush}, ConverterParameter=36}" Style="{StaticResource IconBadge}">
                                        <ui:SymbolIcon
                                            FontSize="20"
                                            Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                                            Symbol="{Binding Icon}" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="12,0,8,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CardTitle}"
                                        Text="{Binding Title}" />
                                    <Border
                                        Grid.Column="2"
                                        Background="{Binding Severity, Converter={StaticResource SeverityBrush}, ConverterParameter=40}"
                                        Style="{StaticResource Pill}">
                                        <TextBlock
                                            FontSize="11.5"
                                            FontWeight="SemiBold"
                                            Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                                            Text="{Binding SeverityText}" />
                                    </Border>
                                </Grid>
                                <TextBlock
                                    Grid.Row="1"
                                    Margin="0,12,0,0"
                                    FontSize="13"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Text="{Binding Subtitle}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding Subtitle}" />
                                <ItemsControl
                                    Grid.Row="2"
                                    Margin="0,12,0,0"
                                    ItemsSource="{Binding Metrics}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:HighlightViewModel}">
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                    Text="{Binding Label}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    Style="{StaticResource BigValue}"
                                                    Text="{Binding Value}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <controls:Sparkline
                                    Grid.Row="3"
                                    Height="40"
                                    Margin="0,12,0,0"
                                    StrokeColor="{StaticResource BrandColor}"
                                    Values="{Binding History}"
                                    Visibility="{Binding HasSpark, Converter={StaticResource VisibleWhen}}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  Updates: drivers and Windows first, programs as suggestions, all apart from the problems and tips  -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr dashboard.updates}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource Caption}"
                            Text="{Binding UpdatesStatus}" />
                        <ui:Button
                            Grid.Column="1"
                            Margin="16,0,0,0"
                            Command="{Binding Main.CheckUpdatesNowCommand}"
                            Content="{loc:Tr dashboard.updates.check}"
                            Icon="{ui:SymbolIcon ArrowSync24}" />
                    </Grid>
                    <ItemsControl ItemTemplate="{StaticResource FindingTemplate}" ItemsSource="{Binding Updates}" />
                    <StackPanel
                        Margin="0,10,0,6"
                        Orientation="Horizontal"
                        Visibility="{Binding ShowUpToDate, Converter={StaticResource VisibleWhen}}">
                        <ui:SymbolIcon
                            FontSize="20"
                            Foreground="{Binding Source={x:Static vm:SeverityValues.Good}, Converter={StaticResource SeverityBrush}}"
                            Symbol="CheckmarkCircle24" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource Body}"
                            Text="{loc:Tr dashboard.updates.none}" />
                    </StackPanel>
                    <ItemsControl ItemTemplate="{StaticResource ManualCheckTemplate}" ItemsSource="{Binding ManualChecks}" />

                    <StackPanel Margin="0,10,0,0" Visibility="{Binding HasSuggestions, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr dashboard.updates.suggested}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource Caption}"
                            Text="{loc:Tr dashboard.updates.suggested.hint}" />
                        <Expander
                            Margin="0,10,0,0"
                            Header="{Binding RuntimesTitle}"
                            IsExpanded="True"
                            Visibility="{Binding HasRuntimes, Converter={StaticResource VisibleWhen}}">
                            <ItemsControl ItemTemplate="{StaticResource ProgramUpdateTemplate}" ItemsSource="{Binding Runtimes}" />
                        </Expander>
                        <Expander
                            Margin="0,8,0,0"
                            Header="{Binding ProgramsTitle}"
                            Visibility="{Binding HasPrograms, Converter={StaticResource VisibleWhen}}">
                            <ItemsControl ItemTemplate="{StaticResource ProgramUpdateTemplate}" ItemsSource="{Binding Programs}" />
                        </Expander>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  Issues  -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr dashboard.issues}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <ItemsControl ItemTemplate="{StaticResource FindingTemplate}" ItemsSource="{Binding Issues}" />
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasIssues, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}">
                        <ui:SymbolIcon
                            FontSize="20"
                            Foreground="{Binding Source={x:Static vm:SeverityValues.Good}, Converter={StaticResource SeverityBrush}}"
                            Symbol="CheckmarkCircle24" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource Body}"
                            Text="{loc:Tr dashboard.noissues}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
