<UserControl
    x:Class="CHC.App.Views.ProgramsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:CHC.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:CHC.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:ProgramsViewModel}"
    mc:Ignorable="d">

    <ScrollViewer FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,20,32,36">

            <!--  Header  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="56"
                    Height="56"
                    Background="{DynamicResource SubtleBrush}"
                    CornerRadius="14">
                    <ui:SymbolIcon
                        FontSize="28"
                        Foreground="{StaticResource BrandBrush}"
                        Symbol="AppsList24" />
                </Border>
                <StackPanel
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{loc:Tr nav.programs}" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="{loc:Tr programs.page.subtitle}" />
                </StackPanel>
            </Grid>

            <Border
                Margin="0,18,0,0"
                Padding="14,10"
                Background="{DynamicResource SubtleBrush}"
                CornerRadius="8"
                Visibility="{Binding Hint, Converter={StaticResource VisibleWhen}}">
                <TextBlock Style="{StaticResource Caption}" Text="{Binding Hint}" />
            </Border>

            <!--  What stands out  -->
            <StackPanel Visibility="{Binding Findings, Converter={StaticResource VisibleWhen}}">
                <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr programs.findings}" />
                <Border Style="{StaticResource Card}">
                    <ItemsControl ItemTemplate="{StaticResource FindingTemplate}" ItemsSource="{Binding Findings}" />
                </Border>
            </StackPanel>

            <!--  Period and sort  -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr programs.list}" />
            <WrapPanel Margin="0,0,0,10">
                <Border
                    Margin="0,0,10,4"
                    Background="{DynamicResource SubtleBrush}"
                    CornerRadius="7">
                    <ListBox
                        ItemsSource="{Binding Periods}"
                        SelectedItem="{Binding SelectedPeriod}"
                        Style="{StaticResource Segments}" />
                </Border>
                <Border
                    Margin="0,0,0,4"
                    Background="{DynamicResource SubtleBrush}"
                    CornerRadius="7">
                    <ListBox
                        ItemsSource="{Binding Sorts}"
                        SelectedItem="{Binding SelectedSort}"
                        Style="{StaticResource Segments}" />
                </Border>
            </WrapPanel>

            <!--  The list  -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock
                        Style="{StaticResource Caption}"
                        Text="{loc:Tr programs.empty}"
                        Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}}" />
                    <Grid Margin="0,0,0,4" Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="172" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Overline}" Text="{loc:Tr programs.col.program}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Overline}" Text="{loc:Tr programs.sort.processor}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Overline}" Text="{loc:Tr programs.sort.memory}" />
                        <TextBlock Grid.Column="3" Style="{StaticResource Overline}" Text="{loc:Tr programs.col.data}" />
                        <TextBlock Grid.Column="4" Style="{StaticResource Overline}" Text="{loc:Tr programs.sort.graphics}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProgramRow}">
                                <Border
                                    Padding="0,8"
                                    BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="172" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0">
                                            <DockPanel>
                                                <Border
                                                    Margin="6,0,0,0"
                                                    Background="{DynamicResource SubtleBrush}"
                                                    DockPanel.Dock="Right"
                                                    Style="{StaticResource Pill}"
                                                    ToolTip="{loc:Tr source.nonchc.tip}"
                                                    Visibility="{Binding IsNonChc, Converter={StaticResource VisibleWhen}}">
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                                        Text="{loc:Tr source.nonchc}" />
                                                </Border>
                                                <TextBlock
                                                    FontSize="13.5"
                                                    FontWeight="Medium"
                                                    Foreground="{DynamicResource TextBrush}"
                                                    Text="{Binding Title}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <TextBlock
                                                Style="{StaticResource Caption}"
                                                Text="{Binding Subtitle}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap"
                                                ToolTip="{Binding Subtitle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontSize="13.5" Foreground="{DynamicResource TextBrush}" Text="{Binding Cpu}" />
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding CpuDetail}" TextWrapping="NoWrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock FontSize="13.5" Foreground="{DynamicResource TextBrush}" Text="{Binding Memory}" />
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding MemoryDetail}" TextWrapping="NoWrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" ToolTip="{Binding DiskDetail}">
                                            <TextBlock FontSize="13.5" Foreground="{DynamicResource TextBrush}" Text="{Binding Disk}" />
                                            <TextBlock
                                                Style="{StaticResource Caption}"
                                                Text="{Binding DiskDetail}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Background="Transparent" ToolTip="{Binding GpuTip}">
                                            <TextBlock FontSize="13.5" Foreground="{DynamicResource TextBrush}" Text="{Binding Gpu}" />
                                            <TextBlock
                                                Style="{StaticResource Caption}"
                                                Text="{Binding GpuDetail}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        Margin="0,10,0,0"
                        Style="{StaticResource Caption}"
                        Text="{loc:Tr programs.note}"
                        Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
