<UserControl
    x:Class="CHC.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:CHC.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:CHC.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="SettingHeader" TargetType="StackPanel">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="980" Margin="32,20,32,36" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="{loc:Tr nav.settings}" />

            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr settings.general}" />

            <ui:CardControl
                Margin="0,0,0,6"
                Icon="{ui:SymbolIcon LocalLanguage24}"
                Visibility="{Binding HasLanguageChoice, Converter={StaticResource VisibleWhen}}">
                <ui:CardControl.Header>
                    <StackPanel Style="{StaticResource SettingHeader}">
                        <TextBlock FontWeight="SemiBold" Style="{StaticResource Body}" Text="{loc:Tr settings.language}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr settings.language.detail}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox
                    MinWidth="200"
                    DisplayMemberPath="NativeName"
                    ItemsSource="{Binding Languages}"
                    SelectedItem="{Binding SelectedLanguage}" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,6" Icon="{ui:SymbolIcon DarkTheme24}">
                <ui:CardControl.Header>
                    <StackPanel Style="{StaticResource SettingHeader}">
                        <TextBlock FontWeight="SemiBold" Style="{StaticResource Body}" Text="{loc:Tr settings.theme}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr settings.theme.detail}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox
                    MinWidth="200"
                    DisplayMemberPath="Title"
                    ItemsSource="{Binding Themes}"
                    SelectedItem="{Binding SelectedTheme}" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,6" Icon="{ui:SymbolIcon Timer24}">
                <ui:CardControl.Header>
                    <StackPanel Style="{StaticResource SettingHeader}">
                        <TextBlock FontWeight="SemiBold" Style="{StaticResource Body}" Text="{loc:Tr settings.refresh}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr settings.refresh.detail}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox
                    MinWidth="200"
                    DisplayMemberPath="Title"
                    ItemsSource="{Binding RefreshIntervals}"
                    SelectedItem="{Binding SelectedRefresh}" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,6" Icon="{ui:SymbolIcon ShieldCheckmark24}">
                <ui:CardControl.Header>
                    <StackPanel Style="{StaticResource SettingHeader}">
                        <TextBlock FontWeight="SemiBold" Style="{StaticResource Body}" Text="{loc:Tr settings.admin}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr settings.admin.detail}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <Grid>
                    <ui:Button
                        Command="{Binding Main.RestartAsAdminCommand}"
                        Content="{loc:Tr admin.restart}"
                        Visibility="{Binding IsElevated, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{Binding Source={x:Static vm:SeverityValues.Good}, Converter={StaticResource SeverityBrush}}"
                        Text="{loc:Tr settings.admin.active}"
                        Visibility="{Binding IsElevated, Converter={StaticResource VisibleWhen}}" />
                </Grid>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,6" Icon="{ui:SymbolIcon Lightbulb24}">
                <ui:CardControl.Header>
                    <StackPanel Style="{StaticResource SettingHeader}">
                        <TextBlock FontWeight="SemiBold" Style="{StaticResource Body}" Text="{loc:Tr settings.welcome}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr settings.welcome.detail}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Command="{Binding ShowWelcomeCommand}" Content="{loc:Tr settings.welcome.open}" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,6" Icon="{ui:SymbolIcon Globe24}">
                <ui:CardControl.Header>
                    <StackPanel Style="{StaticResource SettingHeader}">
                        <TextBlock FontWeight="SemiBold" Style="{StaticResource Body}" Text="{loc:Tr settings.translate}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr settings.translate.detail}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button
                    Command="{Binding OpenLanguagesFolderCommand}"
                    Content="{loc:Tr settings.translate.open}"
                    Icon="{ui:SymbolIcon FolderOpen24}" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,6" Icon="{ui:SymbolIcon ArrowDownload24}">
                <ui:CardControl.Header>
                    <StackPanel Style="{StaticResource SettingHeader}">
                        <TextBlock FontWeight="SemiBold" Style="{StaticResource Body}" Text="{loc:Tr settings.updates}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr settings.updates.detail}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding CheckUpdatesAutomatically}" />
            </ui:CardControl>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr settings.history}" />

            <ui:CardControl Margin="0,0,0,6" Icon="{ui:SymbolIcon History24}">
                <ui:CardControl.Header>
                    <StackPanel Style="{StaticResource SettingHeader}">
                        <TextBlock FontWeight="SemiBold" Style="{StaticResource Body}" Text="{loc:Tr settings.history.record}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr settings.history.record.detail}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding RecordHistory}" />
            </ui:CardControl>

            <ui:CardControl
                Margin="0,0,0,6"
                Icon="{ui:SymbolIcon Dismiss24}"
                Visibility="{Binding RecordHistory, Converter={StaticResource VisibleWhen}}">
                <ui:CardControl.Header>
                    <StackPanel Style="{StaticResource SettingHeader}">
                        <TextBlock FontWeight="SemiBold" Style="{StaticResource Body}" Text="{loc:Tr settings.close}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr settings.close.detail}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox
                    MinWidth="200"
                    DisplayMemberPath="Title"
                    ItemsSource="{Binding CloseChoices}"
                    SelectedItem="{Binding SelectedCloseChoice}" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,6" Icon="{ui:SymbolIcon Power24}">
                <ui:CardControl.Header>
                    <StackPanel Style="{StaticResource SettingHeader}">
                        <TextBlock FontWeight="SemiBold" Style="{StaticResource Body}" Text="{loc:Tr settings.history.startup}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr settings.history.startup.detail}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <Grid>
                    <ui:Button
                        Command="{Binding SetUpStartupCommand}"
                        Content="{loc:Tr settings.history.startup.setup}"
                        Icon="{ui:SymbolIcon ShieldCheckmark24}"
                        Visibility="{Binding StartsWithWindows, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" />
                    <StackPanel Orientation="Horizontal" Visibility="{Binding StartsWithWindows, Converter={StaticResource VisibleWhen}}">
                        <TextBlock
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Foreground="{Binding Source={x:Static vm:SeverityValues.Good}, Converter={StaticResource SeverityBrush}}"
                            Text="{loc:Tr settings.history.startup.on}" />
                        <ui:Button Command="{Binding RemoveStartupCommand}" Content="{loc:Tr settings.history.startup.remove}" />
                    </StackPanel>
                </Grid>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,6" Icon="{ui:SymbolIcon CalendarLtr24}">
                <ui:CardControl.Header>
                    <StackPanel Style="{StaticResource SettingHeader}">
                        <TextBlock FontWeight="SemiBold" Style="{StaticResource Body}" Text="{loc:Tr settings.history.detail}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr settings.history.detail.detail}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox
                    MinWidth="200"
                    DisplayMemberPath="Title"
                    ItemsSource="{Binding DetailPeriods}"
                    SelectedItem="{Binding SelectedDetail}" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,6" Icon="{ui:SymbolIcon Database24}">
                <ui:CardControl.Header>
                    <StackPanel Style="{StaticResource SettingHeader}">
                        <TextBlock FontWeight="SemiBold" Style="{StaticResource Body}" Text="{loc:Tr settings.history.data}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding HistoryInfo}" />
                        <TextBlock
                            Foreground="{Binding Source={x:Static vm:SeverityValues.Warning}, Converter={StaticResource SeverityBrush}}"
                            Style="{StaticResource Caption}"
                            Text="{Binding HistoryProblem}"
                            Visibility="{Binding HistoryProblem, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,8,0"
                        Command="{Binding OpenHistoryFolderCommand}"
                        Content="{loc:Tr settings.translate.open}"
                        Icon="{ui:SymbolIcon FolderOpen24}" />
                    <ui:Button
                        Command="{Binding ClearHistoryCommand}"
                        Content="{loc:Tr settings.history.clear}"
                        Icon="{ui:SymbolIcon Delete24}" />
                </StackPanel>
            </ui:CardControl>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr settings.about}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image
                            Width="52"
                            Height="52"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Source="/Assets/chc.png" />
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextBrush}"
                                Text="CHC — Computer Health Check" />
                            <TextBlock Style="{StaticResource Caption}">
                                <Run Text="{loc:Tr settings.version}" />
                                <Run Text="{Binding Version, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock
                        Margin="0,16,0,0"
                        Style="{StaticResource Body}"
                        Text="{loc:Tr settings.license}" />
                    <TextBlock
                        Margin="0,18,0,8"
                        Style="{StaticResource Overline}"
                        Text="{loc:Tr settings.credits}" />
                    <ItemsControl ItemsSource="{Binding Credits}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ThirdParty}">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource Body}"
                                        Text="{Binding Name}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource Caption}"
                                        Text="{Binding License}" />
                                    <ui:HyperlinkButton
                                        Grid.Column="2"
                                        Padding="4,2"
                                        HorizontalAlignment="Left"
                                        Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Url}"
                                        Content="{Binding Url}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
