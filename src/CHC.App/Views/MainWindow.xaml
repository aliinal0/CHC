<ui:FluentWindow
    x:Class="CHC.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="clr-namespace:CHC.App.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:CHC.App.Views"
    xmlns:vm="clr-namespace:CHC.App.ViewModels"
    Title="CHC - Computer Health Check"
    Width="1320"
    Height="860"
    MinWidth="980"
    MinHeight="620"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
    ExtendsContentIntoTitleBar="True"
    Icon="/Assets/chc.ico"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <ui:FluentWindow.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ComponentViewModel}">
            <views:ComponentView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SensorsViewModel}">
            <views:SensorsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportViewModel}">
            <views:ReportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="CHC · Computer Health Check">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Assets/chc.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Sidebar  -->
            <DockPanel Margin="10,0,8,12">
                <StackPanel
                    Margin="8,6,0,18"
                    DockPanel.Dock="Top"
                    Orientation="Horizontal">
                    <Image
                        Width="38"
                        Height="38"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Source="/Assets/chc.png" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="CHC" />
                        <TextBlock
                            FontSize="11.5"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Computer Health Check" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border
                        Margin="0,0,0,10"
                        Padding="12,10"
                        Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                        CornerRadius="8"
                        Visibility="{Binding IsDemo, Converter={StaticResource VisibleWhen}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    FontSize="16"
                                    Foreground="{StaticResource BrandBrush}"
                                    Symbol="Info24" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{loc:Tr demo.title}" />
                            </StackPanel>
                            <TextBlock
                                Margin="0,4,0,0"
                                Style="{StaticResource Caption}"
                                Text="{loc:Tr demo.detail}" />
                        </StackPanel>
                    </Border>
                    <Border
                        Margin="0,0,0,10"
                        Padding="12,10"
                        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                        CornerRadius="8"
                        Visibility="{Binding IsElevated, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    FontSize="16"
                                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                    Symbol="ShieldError24" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{loc:Tr admin.limited}" />
                            </StackPanel>
                            <TextBlock
                                Margin="0,4,0,8"
                                Style="{StaticResource Caption}"
                                Text="{loc:Tr admin.limited.detail}" />
                            <ui:Button
                                HorizontalAlignment="Stretch"
                                Command="{Binding RestartAsAdminCommand}"
                                Content="{loc:Tr admin.restart}"
                                Icon="{ui:SymbolIcon ShieldCheckmark24}" />
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemTemplate="{StaticResource NavTemplate}" ItemsSource="{Binding FooterNav}" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemTemplate="{StaticResource NavTemplate}" ItemsSource="{Binding MainNav}" />
                </ScrollViewer>
            </DockPanel>

            <!--  Content  -->
            <Border
                Grid.Column="1"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,0,0"
                ClipToBounds="True"
                CornerRadius="8,0,0,0">
                <Grid>
                    <ContentControl Content="{Binding CurrentPage}" Focusable="False" />

                    <ProgressBar
                        Height="3"
                        VerticalAlignment="Top"
                        IsIndeterminate="True"
                        Visibility="{Binding IsScanning, Converter={StaticResource VisibleWhen}}" />

                    <Grid Background="{DynamicResource LayerFillColorDefaultBrush}" Visibility="{Binding IsFirstScan, Converter={StaticResource VisibleWhen}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:ProgressRing
                                Width="64"
                                Height="64"
                                HorizontalAlignment="Center"
                                IsIndeterminate="True" />
                            <TextBlock
                                Margin="0,22,0,0"
                                HorizontalAlignment="Center"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{loc:Tr scan.title}" />
                            <TextBlock
                                Margin="0,6,0,0"
                                HorizontalAlignment="Center"
                                Style="{StaticResource Caption}"
                                Text="{Binding ScanStep}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
