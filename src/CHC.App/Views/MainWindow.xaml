<ui:FluentWindow
    x:Class="CHC.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="clr-namespace:CHC.App.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:CHC.App.Views"
    xmlns:vm="clr-namespace:CHC.App.ViewModels"
    Title="CHC - Computer Health Check"
    Width="1320"
    Height="860"
    MinWidth="980"
    MinHeight="620"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
    Background="{DynamicResource PageBrush}"
    ExtendsContentIntoTitleBar="True"
    FontFamily="{DynamicResource AppFont}"
    Icon="/Assets/chc.ico"
    WindowBackdropType="None"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <ui:FluentWindow.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ComponentViewModel}">
            <views:ComponentView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SensorsViewModel}">
            <views:SensorsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportViewModel}">
            <views:ReportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PerformanceViewModel}">
            <views:PerformanceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NetworkViewModel}">
            <views:NetworkView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TimelineViewModel}">
            <views:TimelineView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LookBackViewModel}">
            <views:LookBackView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DevicesViewModel}">
            <views:DevicesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProgramsViewModel}">
            <views:ProgramsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PowerViewModel}">
            <views:PowerView />
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  The sidebar's column runs up under the title bar  -->
        <Border
            Grid.RowSpan="2"
            Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,0,1,0" />

        <!--  Only the window buttons; the name and logo sit at the top of the sidebar  -->
        <ui:TitleBar Grid.ColumnSpan="2" />

        <Grid Grid.Row="1" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Sidebar  -->
            <DockPanel Margin="10,0,10,12">
                <StackPanel
                    Margin="8,0,0,10"
                    DockPanel.Dock="Top"
                    Orientation="Horizontal">
                    <Image
                        Width="32"
                        Height="32"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Source="/Assets/chc.png" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextBrush}"
                            Text="CHC" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource TextMutedBrush}"
                            Text="Computer Health Check" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border
                        Margin="0,0,0,10"
                        Padding="12,10"
                        Background="{DynamicResource AccentSubtleBrush}"
                        CornerRadius="8"
                        Visibility="{Binding ShowDemoBadge, Converter={StaticResource VisibleWhen}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    FontSize="16"
                                    Foreground="{StaticResource BrandBrush}"
                                    Symbol="Info24" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextBrush}"
                                    Text="{loc:Tr demo.title}" />
                            </StackPanel>
                            <TextBlock
                                Margin="0,4,0,0"
                                Style="{StaticResource Caption}"
                                Text="{loc:Tr demo.detail}" />
                        </StackPanel>
                    </Border>
                    <Border
                        Margin="0,0,0,10"
                        Padding="12,10"
                        Background="{DynamicResource WarningSubtleBrush}"
                        CornerRadius="8"
                        ToolTip="{loc:Tr admin.limited.detail}"
                        Visibility="{Binding IsElevated, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    FontSize="16"
                                    Foreground="{DynamicResource WarningBrush}"
                                    Symbol="ShieldError24" />
                                <TextBlock
                                    Margin="8,0,0,0"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextBrush}"
                                    Text="{loc:Tr admin.limited}" />
                            </StackPanel>
                            <ui:Button
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding RestartAsAdminCommand}"
                                Content="{loc:Tr admin.restart}"
                                Icon="{ui:SymbolIcon ShieldCheckmark24}" />
                        </StackPanel>
                    </Border>
                    <ItemsControl
                        Margin="0,0,14,0"
                        ItemTemplate="{StaticResource NavTemplate}"
                        ItemsSource="{Binding FooterNav}" />
                </StackPanel>

                <!--  The right margin keeps the status dots clear of the scroll bar on small screens  -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl
                        Margin="0,0,14,0"
                        ItemTemplate="{StaticResource NavTemplate}"
                        ItemsSource="{Binding MainNav}" />
                </ScrollViewer>
            </DockPanel>

            <!--  Content  -->
            <Border Grid.Column="1" ClipToBounds="True">
                <Grid>
                    <ContentControl Content="{Binding CurrentPage}" Focusable="False" />

                    <ProgressBar
                        Height="3"
                        VerticalAlignment="Top"
                        IsIndeterminate="True"
                        Visibility="{Binding IsScanning, Converter={StaticResource VisibleWhen}}" />

                    <Grid Background="{DynamicResource PageBrush}" Visibility="{Binding IsFirstScan, Converter={StaticResource VisibleWhen}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:ProgressRing
                                Width="64"
                                Height="64"
                                HorizontalAlignment="Center"
                                IsIndeterminate="True" />
                            <TextBlock
                                Margin="0,22,0,0"
                                HorizontalAlignment="Center"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextBrush}"
                                Text="{loc:Tr scan.title}" />
                            <TextBlock
                                Margin="0,6,0,0"
                                HorizontalAlignment="Center"
                                Style="{StaticResource Caption}"
                                Text="{Binding ScanStep}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
