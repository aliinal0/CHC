<UserControl
    x:Class="CHC.App.Views.HistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:CHC.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:CHC.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:CHC.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:HistoryViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  Legend: a dot and a name per line  -->
        <DataTemplate x:Key="LegendItem" DataType="{x:Type controls:ChartSeries}">
            <StackPanel Margin="14,0,0,0" Orientation="Horizontal">
                <Ellipse
                    Width="9"
                    Height="9"
                    VerticalAlignment="Center"
                    Fill="{Binding Brush}" />
                <TextBlock
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource Caption}"
                    Text="{Binding Name}" />
            </StackPanel>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="Row">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,20,32,36">

            <!--  Header  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="56"
                    Height="56"
                    Background="{DynamicResource SubtleBrush}"
                    CornerRadius="14">
                    <ui:SymbolIcon
                        FontSize="28"
                        Foreground="{StaticResource BrandBrush}"
                        Symbol="DataTrending24" />
                </Border>
                <StackPanel
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{loc:Tr nav.history}" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="{loc:Tr history.page.subtitle}" />
                </StackPanel>
                <Border
                    Grid.Column="2"
                    Background="{DynamicResource SubtleBrush}"
                    Style="{StaticResource Pill}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse
                            Width="8"
                            Height="8"
                            VerticalAlignment="Center"
                            Fill="{Binding Source={x:Static vm:SeverityValues.Good}, Converter={StaticResource SeverityBrush}}"
                            Visibility="{Binding IsRecordingOff, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" />
                        <TextBlock
                            Margin="7,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource Caption}"
                            Text="{Binding Status}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!--  Period  -->
            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Background="{DynamicResource SubtleBrush}"
                    CornerRadius="7">
                    <ListBox
                        Background="Transparent"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource SegmentItem}"
                        ItemsPanel="{StaticResource Row}"
                        ItemsSource="{Binding Ranges}"
                        SelectedItem="{Binding SelectedRange}" />
                </Border>
                <StackPanel
                    Grid.Column="1"
                    Margin="18,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <ui:Button
                        Padding="8,6"
                        Appearance="Transparent"
                        Command="{Binding PreviousCommand}"
                        Icon="{ui:SymbolIcon ChevronLeft24}"
                        ToolTip="{loc:Tr history.previous}" />
                    <TextBlock
                        MinWidth="210"
                        Margin="6,0"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextBrush}"
                        Text="{Binding PeriodLabel}"
                        TextAlignment="Center" />
                    <ui:Button
                        Padding="8,6"
                        Appearance="Transparent"
                        Command="{Binding NextCommand}"
                        Icon="{ui:SymbolIcon ChevronRight24}"
                        ToolTip="{loc:Tr history.next}" />
                </StackPanel>
            </Grid>

            <!--  Recording is off  -->
            <Border
                Margin="0,18,0,0"
                Style="{StaticResource Card}"
                Visibility="{Binding IsRecordingOff, Converter={StaticResource VisibleWhen}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr history.off.title}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource Caption}"
                            Text="{loc:Tr history.off.detail}" />
                    </StackPanel>
                    <ui:Button
                        Grid.Column="1"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding OpenSettingsCommand}"
                        Content="{loc:Tr nav.settings}"
                        Icon="{ui:SymbolIcon Settings24}" />
                </Grid>
            </Border>

            <!--  Nothing in this period  -->
            <Border
                Margin="0,18,0,0"
                Style="{StaticResource Card}"
                Visibility="{Binding HasData, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr history.empty}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource Caption}"
                        Text="{loc:Tr history.empty.detail}" />
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding HasData, Converter={StaticResource VisibleWhen}}">

                <!--  Highlights  -->
                <ItemsControl Margin="0,18,-10,0" ItemsSource="{Binding Tiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:ResponsiveGrid MaxColumns="5" MinItemWidth="190" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:HistoryTile}">
                            <Border Style="{StaticResource Tile}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Title}" />
                                    <TextBlock FontSize="26" Style="{StaticResource BigValue}" Text="{Binding Value}" />
                                    <TextBlock
                                        Style="{StaticResource Caption}"
                                        Text="{Binding Detail}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        ToolTip="{Binding Detail}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  Temperatures  -->
                <Border Margin="0,8,0,0" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <ItemsControl
                                DockPanel.Dock="Right"
                                ItemTemplate="{StaticResource LegendItem}"
                                ItemsPanel="{StaticResource Row}"
                                ItemsSource="{Binding Temperatures}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr history.chart.temps}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr history.chart.temps.detail}" />
                            </StackPanel>
                        </DockPanel>
                        <controls:TimeChart
                            Height="230"
                            Margin="0,14,0,0"
                            Format="{Binding Celsius}"
                            From="{Binding From}"
                            MinSpan="15"
                            Series="{Binding Temperatures}"
                            Slot="{Binding Slot}"
                            To="{Binding To}" />
                    </StackPanel>
                </Border>

                <!--  Load  -->
                <Border Margin="0,12,0,0" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <ItemsControl
                                DockPanel.Dock="Right"
                                ItemTemplate="{StaticResource LegendItem}"
                                ItemsPanel="{StaticResource Row}"
                                ItemsSource="{Binding Loads}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr history.chart.load}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr history.chart.load.detail}" />
                            </StackPanel>
                        </DockPanel>
                        <controls:TimeChart
                            Height="200"
                            Margin="0,14,0,0"
                            Ceiling="100"
                            Floor="0"
                            Format="{Binding Percent}"
                            From="{Binding From}"
                            MinSpan="25"
                            Series="{Binding Loads}"
                            Slot="{Binding Slot}"
                            To="{Binding To}" />
                    </StackPanel>
                </Border>

                <!--  Power  -->
                <Border Margin="0,12,0,0" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <ItemsControl
                                DockPanel.Dock="Right"
                                ItemTemplate="{StaticResource LegendItem}"
                                ItemsPanel="{StaticResource Row}"
                                ItemsSource="{Binding Power}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr history.chart.power}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr history.chart.power.detail}" />
                            </StackPanel>
                        </DockPanel>
                        <controls:TimeChart
                            Height="200"
                            Margin="0,14,0,0"
                            Floor="0"
                            Format="{Binding Watts}"
                            From="{Binding From}"
                            MinSpan="100"
                            Series="{Binding Power}"
                            Slot="{Binding Slot}"
                            To="{Binding To}" />
                    </StackPanel>
                </Border>

                <!--  Network  -->
                <Border Margin="0,12,0,0" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <ItemsControl
                                DockPanel.Dock="Right"
                                ItemTemplate="{StaticResource LegendItem}"
                                ItemsPanel="{StaticResource Row}"
                                ItemsSource="{Binding Network}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr history.chart.network}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr history.chart.network.detail}" />
                            </StackPanel>
                        </DockPanel>
                        <controls:TimeChart
                            Height="170"
                            Margin="0,14,0,0"
                            Floor="0"
                            Format="{Binding Rate}"
                            From="{Binding From}"
                            MinSpan="125000"
                            Series="{Binding Network}"
                            Slot="{Binding Slot}"
                            To="{Binding To}" />
                    </StackPanel>
                </Border>

                <!--  Fans  -->
                <Border
                    Margin="0,12,0,0"
                    Style="{StaticResource Card}"
                    Visibility="{Binding HasFans, Converter={StaticResource VisibleWhen}}">
                    <StackPanel>
                        <DockPanel>
                            <ItemsControl
                                DockPanel.Dock="Right"
                                ItemTemplate="{StaticResource LegendItem}"
                                ItemsPanel="{StaticResource Row}"
                                ItemsSource="{Binding Fans}" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr history.chart.fans}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr history.chart.fans.detail}" />
                            </StackPanel>
                        </DockPanel>
                        <controls:TimeChart
                            Height="150"
                            Margin="0,14,0,0"
                            Floor="0"
                            Format="{Binding Rpm}"
                            From="{Binding From}"
                            MinSpan="500"
                            Series="{Binding Fans}"
                            Slot="{Binding Slot}"
                            To="{Binding To}" />
                    </StackPanel>
                </Border>

                <!--  Programs  -->
                <Border Margin="0,12,0,0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr history.apps}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr history.apps.detail}" />
                        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Apps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:HistoryApp}">
                                    <Grid Margin="0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" MinWidth="180" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Style="{StaticResource Body}"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Temperatures}" />
                                        </StackPanel>
                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <controls:MeterBar
                                                Height="6"
                                                VerticalAlignment="Center"
                                                BarBrush="{StaticResource BrandBrush}"
                                                Value="{Binding Share}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource Body}"
                                                Text="{Binding Time}"
                                                TextAlignment="Right" />
                                        </Grid>
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource Caption}"
                                            Text="{Binding Power}"
                                            TextAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
