<ui:FluentWindow
    x:Class="CHC.App.Views.CloseDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:CHC.App.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="CHC"
    Width="480"
    MinHeight="0"
    Background="{DynamicResource PageBrush}"
    ExtendsContentIntoTitleBar="True"
    FontFamily="{DynamicResource AppFont}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowBackdropType="None"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">
    <StackPanel>
        <ui:TitleBar ShowMaximize="False" ShowMinimize="False" />
        <StackPanel Margin="24,0,24,20">
            <TextBlock
                FontSize="17"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextBrush}"
                Text="{loc:Tr close.title}"
                TextWrapping="Wrap" />
            <TextBlock
                Margin="0,8,0,0"
                Style="{StaticResource Body}"
                Foreground="{DynamicResource TextSecondaryBrush}"
                Text="{loc:Tr close.text}" />
            <CheckBox
                x:Name="RememberBox"
                Margin="-10,16,0,0"
                Content="{loc:Tr close.remember}" />
            <StackPanel
                Margin="0,20,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <ui:Button
                    Click="OnCancel"
                    Content="{loc:Tr close.cancel}"
                    IsCancel="True" />
                <ui:Button
                    Margin="8,0,0,0"
                    AutomationProperties.AutomationId="ExitButton"
                    Click="OnExit"
                    Content="{loc:Tr close.exit}" />
                <ui:Button
                    Margin="8,0,0,0"
                    Appearance="Primary"
                    AutomationProperties.AutomationId="KeepButton"
                    Click="OnKeep"
                    Content="{loc:Tr close.keep}"
                    IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
