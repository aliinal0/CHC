<UserControl
    x:Class="CHC.App.Views.TimelineView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:CHC.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:CHC.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:TimelineViewModel}"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,20,32,36">

            <!--  Header  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="56"
                    Height="56"
                    Background="{DynamicResource SubtleBrush}"
                    CornerRadius="14">
                    <ui:SymbolIcon
                        FontSize="28"
                        Foreground="{StaticResource BrandBrush}"
                        Symbol="Timeline24" />
                </Border>
                <StackPanel
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{loc:Tr nav.timeline}" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="{loc:Tr timeline.page.subtitle}" />
                </StackPanel>
            </Grid>

            <!--  Filter  -->
            <Border
                Margin="0,22,0,0"
                HorizontalAlignment="Left"
                Background="{DynamicResource SubtleBrush}"
                CornerRadius="7">
                <ListBox
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource SegmentItem}"
                    ItemsSource="{Binding Filters}"
                    SelectedItem="{Binding SelectedFilter}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </Border>

            <!--  The change the problems started with  -->
            <Border
                Margin="0,16,0,0"
                Padding="16,12"
                Background="{Binding Source={x:Static vm:SeverityValues.Warning}, Converter={StaticResource SeverityBrush}, ConverterParameter=26}"
                CornerRadius="8"
                Visibility="{Binding Suspect, Converter={StaticResource VisibleWhen}}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon
                        VerticalAlignment="Center"
                        FontSize="20"
                        Foreground="{Binding Source={x:Static vm:SeverityValues.Warning}, Converter={StaticResource SeverityBrush}}"
                        Symbol="Warning24" />
                    <TextBlock
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Style="{StaticResource Body}"
                        Text="{Binding Suspect}" />
                </StackPanel>
            </Border>

            <!--  Nothing yet  -->
            <Border
                Margin="0,16,0,0"
                Style="{StaticResource Card}"
                Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr timeline.empty}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource Caption}"
                        Text="{loc:Tr timeline.empty.detail}" />
                </StackPanel>
            </Border>

            <!--  Days  -->
            <ItemsControl ItemsSource="{Binding Days}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TimelineDay}">
                        <StackPanel Margin="0,18,0,0">
                            <TextBlock
                                Margin="2,0,0,8"
                                Style="{StaticResource Overline}"
                                Text="{Binding Title}" />
                            <Border Padding="20,6" Style="{StaticResource Card}">
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:TimelineItem}">
                                            <Grid Margin="0,9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    x:Name="Badge"
                                                    Width="34"
                                                    Height="34"
                                                    VerticalAlignment="Top"
                                                    Background="{DynamicResource SubtleBrush}"
                                                    CornerRadius="9">
                                                    <ui:SymbolIcon
                                                        x:Name="Glyph"
                                                        FontSize="18"
                                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                                        Symbol="{Binding Icon}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="14,0,16,0">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Style="{StaticResource Body}"
                                                        Text="{Binding Title}" />
                                                    <TextBlock
                                                        Style="{StaticResource Caption}"
                                                        Text="{Binding Detail}"
                                                        Visibility="{Binding HasDetail, Converter={StaticResource VisibleWhen}}" />
                                                    <TextBlock
                                                        Margin="0,2,0,0"
                                                        FontWeight="SemiBold"
                                                        Foreground="{Binding Source={x:Static vm:SeverityValues.Warning}, Converter={StaticResource SeverityBrush}}"
                                                        Style="{StaticResource Caption}"
                                                        Text="{Binding Note}"
                                                        Visibility="{Binding HasNote, Converter={StaticResource VisibleWhen}}" />
                                                </StackPanel>
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Margin="0,2,0,0"
                                                    VerticalAlignment="Top"
                                                    Style="{StaticResource Caption}"
                                                    Text="{Binding Time}" />
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                                    <Setter TargetName="Badge" Property="Background" Value="{Binding Source={x:Static vm:SeverityValues.Critical}, Converter={StaticResource SeverityBrush}, ConverterParameter=36}" />
                                                    <Setter TargetName="Glyph" Property="Foreground" Value="{Binding Source={x:Static vm:SeverityValues.Critical}, Converter={StaticResource SeverityBrush}}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasNote}" Value="True">
                                                    <Setter TargetName="Badge" Property="Background" Value="{Binding Source={x:Static vm:SeverityValues.Warning}, Converter={StaticResource SeverityBrush}, ConverterParameter=36}" />
                                                    <Setter TargetName="Glyph" Property="Foreground" Value="{Binding Source={x:Static vm:SeverityValues.Warning}, Converter={StaticResource SeverityBrush}}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
