<UserControl
    x:Class="CHC.App.Views.SensorsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:CHC.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:CHC.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:SensorsViewModel}"
    mc:Ignorable="d">

    <Grid Margin="32,26,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="{loc:Tr nav.sensors}" />
                <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding CountText}" />
            </StackPanel>
            <ui:TextBox
                Width="300"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Icon="{ui:SymbolIcon Search24}"
                PlaceholderText="{loc:Tr sensors.search}"
                Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,36">
                <Border Style="{StaticResource Card}" Visibility="{Binding Groups.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon FontSize="20" Symbol="Info24" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource Body}"
                            Text="{loc:Tr sensors.empty}" />
                    </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource VisibleWhen}}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SensorGroupViewModel}">
                            <Border Margin="0,0,0,14" Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Title}" />
                                        <Border
                                            Margin="10,0,0,0"
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                            Style="{StaticResource Pill}">
                                            <TextBlock
                                                FontSize="11.5"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding KindText}" />
                                        </Border>
                                    </StackPanel>
                                    <ContentControl ContentTemplate="{StaticResource SensorHeaderTemplate}" />
                                    <ItemsControl ItemTemplate="{StaticResource SensorRowTemplate}" ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource VisibleWhen}}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
