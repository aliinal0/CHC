<UserControl
    x:Class="CHC.App.Views.ComponentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:CHC.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:CHC.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pres="clr-namespace:CHC.Core.Presentation;assembly=CHC.Core"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:CHC.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:ComponentViewModel}"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,26,32,36">

            <!--  1. General: what is it and is it OK?  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="56"
                    Height="56"
                    Background="{Binding Severity, Converter={StaticResource SeverityBrush}, ConverterParameter=36}"
                    CornerRadius="14">
                    <ui:SymbolIcon
                        FontSize="28"
                        Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                        Symbol="{Binding Icon}" />
                </Border>
                <StackPanel
                    Grid.Column="1"
                    Margin="16,0,16,0"
                    VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding Summary}" />
                </StackPanel>
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Grid Width="68" Height="68">
                        <controls:ScoreRing
                            RingBrush="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                            Thickness="7"
                            Value="{Binding Score}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding Score}" />
                    </Grid>
                    <Border
                        Margin="14,0,0,0"
                        Background="{Binding Severity, Converter={StaticResource SeverityBrush}, ConverterParameter=40}"
                        Style="{StaticResource Pill}">
                        <TextBlock
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                            Text="{Binding SeverityText}" />
                    </Border>
                </StackPanel>
            </Grid>

            <!--  2. Findings: what we checked and what to do  -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr component.findings}" />
            <Border Style="{StaticResource Card}">
                <ItemsControl ItemTemplate="{StaticResource FindingTemplate}" ItemsSource="{Binding Findings}" />
            </Border>

            <!--  3+. Devices: live values, then technical details  -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr component.devices}" />
            <ItemsControl ItemsSource="{Binding Devices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DeviceViewModel}">
                        <Border Margin="0,0,0,16" Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock
                                            FontSize="19"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding Title}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Margin="0,3,0,0"
                                            Style="{StaticResource Caption}"
                                            Text="{Binding Subtitle}"
                                            Visibility="{Binding Subtitle, Converter={StaticResource VisibleWhen}}" />
                                    </StackPanel>
                                    <Border
                                        VerticalAlignment="Top"
                                        Background="{Binding Severity, Converter={StaticResource SeverityBrush}, ConverterParameter=40}"
                                        Style="{StaticResource Pill}"
                                        Visibility="{Binding SeverityText, Converter={StaticResource VisibleWhen}}">
                                        <TextBlock
                                            FontSize="11.5"
                                            FontWeight="SemiBold"
                                            Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                                            Text="{Binding SeverityText}" />
                                    </Border>
                                </Grid>

                                <ItemsControl
                                    Margin="0,16,-10,0"
                                    ItemTemplate="{StaticResource HighlightTemplate}"
                                    ItemsSource="{Binding Highlights}"
                                    Visibility="{Binding Highlights, Converter={StaticResource VisibleWhen}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <controls:ResponsiveGrid MaxColumns="4" MinItemWidth="170" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <ItemsControl
                                    Margin="0,4,0,0"
                                    ItemTemplate="{StaticResource MeterTemplate}"
                                    ItemsSource="{Binding Meters}"
                                    Visibility="{Binding Meters, Converter={StaticResource VisibleWhen}}" />

                                <!--  Technical specifications  -->
                                <Expander
                                    Margin="0,14,0,0"
                                    IsExpanded="True"
                                    Visibility="{Binding Specs, Converter={StaticResource VisibleWhen}}">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon FontSize="16" Symbol="DocumentText24" />
                                            <TextBlock
                                                Margin="10,0,0,0"
                                                FontWeight="SemiBold"
                                                Text="{loc:Tr component.specs}" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <ItemsControl ItemsSource="{Binding Specs}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:ResponsiveGrid MaxColumns="2" MinItemWidth="380" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type pres:SpecGroup}">
                                                <StackPanel Margin="0,4,24,12">
                                                    <TextBlock Style="{StaticResource Overline}" Text="{Binding Title}" />
                                                    <ItemsControl ItemsSource="{Binding Rows}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type pres:SpecRow}">
                                                                <Border
                                                                    Padding="0,6"
                                                                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                                    BorderThickness="0,0,0,1">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="0.42*" />
                                                                            <ColumnDefinition Width="0.58*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock
                                                                            Margin="0,0,10,0"
                                                                            FontSize="13"
                                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                            Text="{Binding Key}"
                                                                            TextWrapping="Wrap" />
                                                                        <TextBlock
                                                                            Grid.Column="1"
                                                                            FontSize="13"
                                                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                            Text="{Binding Value}"
                                                                            TextWrapping="Wrap" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>

                                <!--  Tables (memory modules, SMART attributes, events...)  -->
                                <ItemsControl ItemsSource="{Binding Tables}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:TableViewModel}">
                                            <Expander Margin="0,10,0,0">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon FontSize="16" Symbol="Table24" />
                                                        <TextBlock
                                                            Margin="10,0,0,0"
                                                            FontWeight="SemiBold"
                                                            Text="{Binding Title}" />
                                                        <TextBlock
                                                            Margin="8,0,0,0"
                                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                            Text="{Binding RowCount, StringFormat=({0})}" />
                                                    </StackPanel>
                                                </Expander.Header>
                                                <DataGrid ItemsSource="{Binding View}" Style="{StaticResource ReadOnlyGrid}" />
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!--  Raw live sensors: the most technical level  -->
                                <Expander Margin="0,10,0,0" Visibility="{Binding Sensors, Converter={StaticResource VisibleWhen}}">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon FontSize="16" Symbol="Pulse24" />
                                            <TextBlock
                                                Margin="10,0,0,0"
                                                FontWeight="SemiBold"
                                                Text="{Binding SensorsHeader}" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel>
                                        <ContentControl ContentTemplate="{StaticResource SensorHeaderTemplate}" />
                                        <ItemsControl ItemTemplate="{StaticResource SensorRowTemplate}" ItemsSource="{Binding Sensors}" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
