<UserControl
    x:Class="CHC.App.Views.ComponentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:CHC.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:CHC.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pres="clr-namespace:CHC.Core.Presentation;assembly=CHC.Core"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:CHC.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:ComponentViewModel}"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,20,32,36">

            <!--  1. General: what is it and is it OK?  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="56"
                    Height="56"
                    Background="{Binding Severity, Converter={StaticResource SeverityBrush}, ConverterParameter=36}"
                    CornerRadius="14">
                    <ui:SymbolIcon
                        FontSize="28"
                        Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                        Symbol="{Binding Icon}" />
                </Border>
                <StackPanel
                    Grid.Column="1"
                    Margin="16,0,16,0"
                    VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding Summary}" />
                </StackPanel>
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Grid Width="68" Height="68">
                        <controls:ScoreRing
                            RingBrush="{Binding GaugeSeverity, Converter={StaticResource SeverityBrush}}"
                            Thickness="7"
                            Value="{Binding Score}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextBrush}"
                            Text="{Binding ScoreText}" />
                    </Grid>
                    <Border
                        Margin="14,0,0,0"
                        Background="{Binding Severity, Converter={StaticResource SeverityBrush}, ConverterParameter=40}"
                        Style="{StaticResource Pill}">
                        <TextBlock
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                            Text="{Binding SeverityText}" />
                    </Border>
                </StackPanel>
            </Grid>

            <!--  2. Findings: what we checked and what to do  -->
            <StackPanel Visibility="{Binding OtherFindings, Converter={StaticResource VisibleWhen}}">
                <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr component.findings}" />
                <Border Style="{StaticResource Card}">
                    <ItemsControl ItemTemplate="{StaticResource FindingTemplate}" ItemsSource="{Binding OtherFindings}" />
                </Border>
            </StackPanel>

            <!--  Updates: apart from the problems and tips  -->
            <StackPanel Visibility="{Binding Updates, Converter={StaticResource VisibleWhen}}">
                <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr component.updates}" />
                <Border Style="{StaticResource Card}">
                    <ItemsControl ItemTemplate="{StaticResource FindingTemplate}" ItemsSource="{Binding Updates}" />
                </Border>
            </StackPanel>

            <!--  3+. Devices: live values, then technical details  -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr component.devices}" />
            <ItemsControl ItemTemplate="{StaticResource DeviceTemplate}" ItemsSource="{Binding Devices}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
