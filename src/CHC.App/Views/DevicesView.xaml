<UserControl
    x:Class="CHC.App.Views.DevicesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:CHC.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:CHC.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:DevicesViewModel}"
    mc:Ignorable="d">

    <ScrollViewer FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,20,32,36">

            <!--  Header  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="56"
                    Height="56"
                    Background="{DynamicResource SubtleBrush}"
                    CornerRadius="14">
                    <ui:SymbolIcon
                        FontSize="28"
                        Foreground="{StaticResource BrandBrush}"
                        Symbol="PlugConnected24" />
                </Border>
                <StackPanel
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{loc:Tr nav.devices}" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="{loc:Tr devices.page.subtitle}" />
                </StackPanel>
            </Grid>

            <!--  What is wrong  -->
            <StackPanel Visibility="{Binding Findings, Converter={StaticResource VisibleWhen}}">
                <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr devices.findings}" />
                <Border Style="{StaticResource Card}">
                    <ItemsControl ItemTemplate="{StaticResource FindingTemplate}" ItemsSource="{Binding Findings}" />
                </Border>
            </StackPanel>

            <!--  Wi-Fi  -->
            <StackPanel Visibility="{Binding HasWifi, Converter={StaticResource VisibleWhen}}">
                <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr devices.wifi}" />
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Overline}" Text="{loc:Tr devices.wifi.average}" />
                            <TextBlock Style="{StaticResource BigValue}" Text="{Binding WifiSignal}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource Overline}" Text="{loc:Tr devices.wifi.lowest}" />
                            <TextBlock Style="{StaticResource BigValue}" Text="{Binding WifiLowest}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Overline}" Text="{loc:Tr devices.wifi.drops}" />
                            <TextBlock Style="{StaticResource BigValue}" Text="{Binding WifiDrops}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Style="{StaticResource Overline}" Text="{loc:Tr devices.wifi.failed}" />
                            <TextBlock Style="{StaticResource BigValue}" Text="{Binding WifiFailed}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!--  What is connected  -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr devices.list}" />
            <Border Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}}">
                <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr devices.empty}" />
            </Border>
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DeviceGroup}">
                        <Border Margin="0,0,0,10" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,4" Style="{StaticResource Overline}" Text="{Binding Title}" />
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:DeviceRow}">
                                            <Grid Margin="0,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Width="32"
                                                    Height="32"
                                                    Background="{DynamicResource SubtleBrush}"
                                                    CornerRadius="8">
                                                    <ui:SymbolIcon
                                                        FontSize="17"
                                                        Foreground="{StaticResource BrandBrush}"
                                                        Symbol="{Binding Icon}" />
                                                </Border>
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Margin="12,0,12,0"
                                                    VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="13.5"
                                                        FontWeight="Medium"
                                                        Foreground="{DynamicResource TextBrush}"
                                                        Text="{Binding Name}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Style="{StaticResource Caption}"
                                                        Text="{Binding Connection}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap" />
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Column="2"
                                                    Margin="0,0,12,0"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Visibility="{Binding HasBattery, Converter={StaticResource VisibleWhen}}">
                                                    <ui:SymbolIcon
                                                        Margin="0,0,4,0"
                                                        FontSize="16"
                                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                                        Symbol="Battery524" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="13"
                                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                                        Text="{Binding Battery}" />
                                                </StackPanel>
                                                <Border
                                                    Grid.Column="3"
                                                    Background="{Binding Severity, Converter={StaticResource SeverityBrush}, ConverterParameter=40}"
                                                    Style="{StaticResource Pill}">
                                                    <TextBlock
                                                        FontSize="11.5"
                                                        FontWeight="SemiBold"
                                                        Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                                                        Text="{Binding SeverityText}" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
