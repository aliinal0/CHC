<UserControl
    x:Class="CHC.App.Views.PowerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:CHC.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:CHC.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:CHC.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:PowerViewModel}"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,20,32,36">

            <!--  Header  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="56"
                    Height="56"
                    Background="{DynamicResource SubtleBrush}"
                    CornerRadius="14">
                    <ui:SymbolIcon
                        FontSize="28"
                        Foreground="{StaticResource BrandBrush}"
                        Symbol="Flash24" />
                </Border>
                <StackPanel
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{loc:Tr nav.power}" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="{loc:Tr power.page.subtitle}" />
                </StackPanel>
            </Grid>

            <!--  A laptop: the charger is its power supply  -->
            <Border
                Margin="0,22,0,0"
                Style="{StaticResource Card}"
                Visibility="{Binding IsLaptop, Converter={StaticResource VisibleWhen}}">
                <TextBlock Style="{StaticResource Body}" Text="{loc:Tr power.laptop}" />
            </Border>

            <StackPanel Visibility="{Binding IsLaptop, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}">

                <!--  The supply  -->
                <Border Margin="0,22,0,0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Overline}" Text="{loc:Tr power.supply}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource CardTitle}"
                            Text="{Binding SupplyTitle}" />

                        <!--  It reports its own readings  -->
                        <StackPanel Visibility="{Binding Reports, Converter={StaticResource VisibleWhen}}">
                            <TextBlock
                                Margin="0,4,0,0"
                                Style="{StaticResource Caption}"
                                Text="{loc:Tr power.supply.reports}" />
                            <ItemsControl Margin="0,14,-10,-10" ItemsSource="{Binding Readings}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:ResponsiveGrid MaxColumns="5" MinItemWidth="150" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:HistoryTile}">
                                        <Border Style="{StaticResource Tile}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Caption}" Text="{Binding Title}" />
                                                <TextBlock Style="{StaticResource BigValue}" Text="{Binding Value}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!--  An ordinary supply: the user describes it  -->
                        <StackPanel Visibility="{Binding Reports, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}">
                            <TextBlock
                                Margin="0,4,0,0"
                                Style="{StaticResource Caption}"
                                Text="{loc:Tr power.supply.enter}" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" MaxWidth="320" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        Style="{StaticResource Caption}"
                                        Text="{loc:Tr power.field.watts}" />
                                    <ui:NumberBox
                                        ClearButtonEnabled="False"
                                        Maximum="3000"
                                        Minimum="0"
                                        PlaceholderText="750"
                                        SmallChange="50"
                                        Value="{Binding Watts, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        Style="{StaticResource Caption}"
                                        Text="{loc:Tr power.field.rating}" />
                                    <ComboBox
                                        HorizontalAlignment="Stretch"
                                        DisplayMemberPath="Title"
                                        ItemsSource="{Binding Ratings}"
                                        SelectedItem="{Binding SelectedRating}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        Style="{StaticResource Caption}"
                                        Text="{loc:Tr power.field.model}" />
                                    <ui:TextBox PlaceholderText="Corsair RM750e" Text="{Binding Model, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  Headroom  -->
                <Border
                    Margin="0,12,0,0"
                    Style="{StaticResource Card}"
                    Visibility="{Binding HasPeak, Converter={StaticResource VisibleWhen}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr power.headroom}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr power.headroom.detail}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,28,0">
                                <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr power.peak}" />
                                <TextBlock FontSize="30" Style="{StaticResource BigValue}" Text="{Binding PeakText}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding PeakDetail}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Body}" Text="{Binding LoadText}" />
                                <controls:MeterBar
                                    Height="10"
                                    Margin="0,8,0,8"
                                    BarBrush="{Binding LoadSeverity, Converter={StaticResource SeverityBrush}}"
                                    Value="{Binding Load}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding Recommended}" />
                                <TextBlock
                                    Style="{StaticResource Caption}"
                                    Text="{Binding Efficiency}"
                                    Visibility="{Binding Efficiency, Converter={StaticResource VisibleWhen}}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  Findings  -->
                <Border
                    Margin="0,12,0,0"
                    Style="{StaticResource Card}"
                    Visibility="{Binding Findings, Converter={StaticResource VisibleWhen}}">
                    <ItemsControl ItemTemplate="{StaticResource FindingTemplate}" ItemsSource="{Binding Findings}" />
                </Border>

                <!--  Power over the week  -->
                <Border Margin="0,12,0,0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr power.chart}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr history.chart.power.detail}" />
                        <TextBlock
                            Margin="0,8,0,0"
                            FontWeight="SemiBold"
                            Style="{StaticResource Caption}"
                            Text="{loc:Tr power.chart.empty}"
                            Visibility="{Binding HasPowerHistory, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" />
                        <controls:TimeChart
                            Height="220"
                            Margin="0,14,0,0"
                            Floor="0"
                            Format="{Binding WattsFormat}"
                            From="{Binding From}"
                            MinSpan="100"
                            Reference="{Binding Reference}"
                            ReferenceLabel="{Binding ReferenceLabel}"
                            Series="{Binding PowerSeries}"
                            Slot="{Binding Slot}"
                            To="{Binding To}" />
                    </StackPanel>
                </Border>

                <!--  Rails  -->
                <Border
                    Margin="0,12,0,0"
                    Style="{StaticResource Card}"
                    Visibility="{Binding Rails, Converter={StaticResource VisibleWhen}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr power.rails}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr power.rails.detail}" />
                        <Grid Margin="0,14,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Style="{StaticResource Overline}" Text="{loc:Tr power.rail.now}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource Overline}" Text="{loc:Tr power.rail.lowest}" />
                            <TextBlock Grid.Column="3" Style="{StaticResource Overline}" Text="{loc:Tr power.rail.allowed}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Rails}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RailRow}">
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Style="{StaticResource Body}"
                                            Text="{Binding Name}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource Body}"
                                            Text="{Binding Now}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Style="{StaticResource Body}"
                                            Text="{Binding Lowest}" />
                                        <TextBlock
                                            Grid.Column="3"
                                            Style="{StaticResource Caption}"
                                            Text="{Binding Allowed}" />
                                        <Border
                                            Grid.Column="4"
                                            Background="{Binding Severity, Converter={StaticResource SeverityBrush}, ConverterParameter=36}"
                                            Style="{StaticResource Pill}">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}"
                                                Text="{Binding Status}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
