<UserControl
    x:Class="CHC.App.Views.NetworkView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:CHC.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:CHC.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:CHC.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:NetworkViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="LiveTile" BasedOn="{StaticResource Tile}" TargetType="Border" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,20,32,36">

            <!--  Header  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="56"
                    Height="56"
                    Background="{DynamicResource SubtleBrush}"
                    CornerRadius="14">
                    <ui:SymbolIcon
                        FontSize="28"
                        Foreground="{StaticResource BrandBrush}"
                        Symbol="Globe24" />
                </Border>
                <StackPanel
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{loc:Tr nav.network}" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="{loc:Tr net.page.subtitle}" />
                </StackPanel>
            </Grid>

            <!--  Start / stop  -->
            <Border Margin="0,22,0,0" Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Status}" TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,6,0,0"
                                Style="{StaticResource Caption}"
                                Text="{loc:Tr net.howto}" />
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <ui:Button
                                Appearance="Primary"
                                Command="{Binding StartCommand}"
                                Content="{loc:Tr net.start}"
                                Icon="{ui:SymbolIcon Play24}"
                                Visibility="{Binding IsRunning, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" />
                            <ui:Button
                                Appearance="Caution"
                                Command="{Binding StopCommand}"
                                Content="{loc:Tr net.stop}"
                                Icon="{ui:SymbolIcon Stop24}"
                                Visibility="{Binding IsRunning, Converter={StaticResource VisibleWhen}}" />
                        </Grid>
                    </Grid>

                    <Border
                        Margin="0,14,0,0"
                        Padding="14,10"
                        Background="{DynamicResource WarningSubtleBrush}"
                        CornerRadius="8"
                        Visibility="{Binding ShowAdminHint, Converter={StaticResource VisibleWhen}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon
                                VerticalAlignment="Center"
                                FontSize="18"
                                Foreground="{DynamicResource WarningBrush}"
                                Symbol="ShieldError24" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="10,0,12,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource Body}"
                                Text="{loc:Tr net.needadmin}"
                                TextWrapping="Wrap" />
                            <ui:Button
                                Grid.Column="2"
                                Command="{Binding Main.RestartAsAdminCommand}"
                                Content="{loc:Tr admin.restart}"
                                Icon="{ui:SymbolIcon ShieldCheckmark24}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!--  Live values  -->
            <StackPanel Visibility="{Binding HasLive, Converter={StaticResource VisibleWhen}}">
                <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr perf.live}" />
                <controls:ResponsiveGrid
                    Margin="0,0,-10,0"
                    MaxColumns="4"
                    MinItemWidth="170">
                    <Border Style="{StaticResource LiveTile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr label.ping}" />
                            <TextBlock FontSize="30" Style="{StaticResource BigValue}" Text="{Binding PingText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource LiveTile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr label.jitter}" />
                            <TextBlock FontSize="30" Style="{StaticResource BigValue}" Text="{Binding JitterText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource LiveTile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr label.packetloss}" />
                            <TextBlock FontSize="30" Style="{StaticResource BigValue}" Text="{Binding LossText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource LiveTile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr label.lagspikes}" />
                            <TextBlock FontSize="30" Style="{StaticResource BigValue}" Text="{Binding SpikesText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource LiveTile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr label.routerping}" />
                            <TextBlock Style="{StaticResource BigValue}" Text="{Binding RouterText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource LiveTile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr label.dns}" />
                            <TextBlock Style="{StaticResource BigValue}" Text="{Binding DnsText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource LiveTile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr label.download}" />
                            <TextBlock Style="{StaticResource BigValue}" Text="{Binding DownText}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource LiveTile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr label.upload}" />
                            <TextBlock Style="{StaticResource BigValue}" Text="{Binding UpText}" />
                        </StackPanel>
                    </Border>
                </controls:ResponsiveGrid>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Overline}" Text="{loc:Tr net.chart.internet}" />
                            <controls:Sparkline
                                Height="110"
                                Capacity="120"
                                Maximum="{Binding InternetChartMax}"
                                StrokeColor="{StaticResource BrandColor}"
                                Values="{Binding InternetHistory}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Overline}" Text="{loc:Tr net.chart.router}" />
                            <controls:Sparkline
                                Height="110"
                                Capacity="120"
                                Maximum="{Binding GatewayChartMax}"
                                StrokeColor="#E8A317"
                                Values="{Binding GatewayHistory}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!--  Analysis  -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr perf.results}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,6"
                        Style="{StaticResource Caption}"
                        Text="{Binding Result.Summary}" />
                    <ItemsControl ItemTemplate="{StaticResource FindingTemplate}" ItemsSource="{Binding Result.Findings}" />
                </StackPanel>
            </Border>
            <ItemsControl
                Margin="0,16,0,0"
                ItemTemplate="{StaticResource DeviceTemplate}"
                ItemsSource="{Binding Result.Devices}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
