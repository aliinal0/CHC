<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>CHC.App</RootNamespace>
    <AssemblyName>CHC</AssemblyName>
    <ApplicationIcon>Assets\chc.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>CHC - Computer Health Check</AssemblyTitle>
    <!-- Single-file publish: bundle WebView2Loader.dll too, so CHC.exe is the only file to ship. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CHC.Core\CHC.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\chc.png" />
    <Resource Include="Assets\chc.ico" />
  </ItemGroup>

</Project>
